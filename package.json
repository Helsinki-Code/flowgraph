{
  "name": "token-flamegraph",
  "version": "0.1.0",
  "description": "CPU profiler for AI agent sessions — visualize where tokens burn",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.6.0"
  },
  "workspaces": [
    "packages/sdk",
    "packages/storage",
    "packages/server",
    "packages/web"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "build:server": "npm --prefix packages/storage run build && npm --prefix packages/sdk run build && npm --prefix packages/server run build",
    "build:web": "npm --prefix packages/web run build",
    "dev": "npm run dev --workspace=packages/server",
    "test": "npm run test --workspaces"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "kleur": "^4.1.5",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@astrojs/node": "^10.0.4",
    "emoji-regex-xs": "^2.0.1",
    "flamegraph-sdk": "^0.1.0",
    "ulid": "^2.3.0"
  }
}
