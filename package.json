{
  "name": "token-flamegraph",
  "version": "0.1.0",
  "description": "CPU profiler for AI agent sessions â€” visualize where tokens burn",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.6.0"
  },
  "workspaces": [
    "packages/sdk",
    "packages/storage",
    "packages/server",
    "packages/web"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "build:server": "npm --prefix packages/storage run build && npm --prefix packages/sdk run build && npm --prefix packages/server run build",
    "build:web": "npm --prefix packages/web run build",
    "dev": "npm run dev --workspace=packages/server",
    "test": "npm run test --workspaces",
    "secret:scan": "node scripts/secret-scan.mjs",
    "prepare": "node scripts/setup-hooks.mjs",
    "test:ci": "npm run secret:scan && npm run test && npm run build:server && npm run build:web"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@types/node": "^20.11.0",
    "@vercel/nft": "^1.5.0",
    "boxen": "^8.0.1",
    "kleur": "^4.1.5",
    "ora": "^9.3.0",
    "strip-ansi": "^7.2.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "yocto-queue": "^1.2.2"
  },
  "dependencies": {
    "@astrojs/node": "^10.0.4",
    "@fastify/rate-limit": "^10.3.0",
    "astro": "^6.1.5",
    "emoji-regex-xs": "^2.0.1",
    "flamegraph-sdk": "*",
    "nanostores": "^1.2.0",
    "ulid": "^2.3.0"
  }
}
