---
// Simplified Flame Graph - fast rendering while fixing build issues
interface Props {
  tree: any;
  sessionId: string;
}

const { tree, sessionId } = Astro.props;

function flattenTree(node: any, depth: number = 0): Array<any> {
  const result = [{ ...node, depth }];
  for (const child of node.children || []) {
    result.push(...flattenTree(child, depth + 1));
  }
  return result;
}

const nodes = flattenTree(tree);
const totalCost = tree?.costUsd || 0;
const totalDuration = tree?.durationMs || 1;

function getColor(kind: string): string {
  switch (kind) {
    case "session":
      return "#8b5cf6";
    case "turn":
      return "#6366f1";
    case "llm_call":
      return "#3b82f6";
    case "tool_exec":
      return "#f97316";
    case "context_build":
      return "#10b981";
    default:
      return "#6b7280";
  }
}
---

<div class="fg-container">
  <style>
    .fg-container {
      background: #0f172a;
      border-radius: 0.5rem;
      border: 1px solid #334155;
      overflow: hidden;
      padding: 1rem;
    }

    .fg-title {
      font-size: 0.875rem;
      color: #94a3b8;
      margin-bottom: 1rem;
      text-transform: uppercase;
      font-weight: 600;
    }

    .fg-rows {
      display: flex;
      flex-direction: column;
      gap: 3px;
    }

    .fg-row {
      display: flex;
      align-items: center;
      height: 28px;
      gap: 1rem;
    }

    .fg-depth-label {
      color: #94a3b8;
      font-size: 0.75rem;
      min-width: 60px;
      text-align: right;
      font-family: "JetBrains Mono", monospace;
    }

    .fg-bar-container {
      flex: 1;
      position: relative;
      display: flex;
      align-items: center;
    }

    .fg-bar {
      height: 24px;
      background: #3b82f6;
      border: 1px solid #1e293b;
      border-radius: 4px;
      padding: 0 8px;
      display: flex;
      align-items: center;
      cursor: pointer;
      transition: all 0.2s;
      color: #e2e8f0;
      font-size: 11px;
      font-family: "JetBrains Mono", monospace;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      position: relative;
      min-width: 50px;
    }

    .fg-bar:hover {
      opacity: 0.85;
      box-shadow: 0 0 8px rgba(249, 115, 22, 0.4);
    }

    .fg-bar.loop {
      border: 2px solid #dc2626;
      background: #991b1b;
      box-shadow: 0 0 6px rgba(220, 38, 38, 0.6);
    }

    .fg-bar.error {
      background: #f97316;
    }

    .fg-tooltip-hint {
      font-size: 9px;
      color: #94a3b8;
      padding: 2px 4px;
      margin-left: auto;
      opacity: 0;
      transition: opacity 0.2s;
    }

    .fg-row:hover .fg-tooltip-hint {
      opacity: 1;
    }

    .empty-state {
      padding: 2rem;
      text-align: center;
      color: #94a3b8;
    }
  </style>

  {
    nodes.length === 0 ? (
      <div class="empty-state">No events to display</div>
    ) : (
      <>
        <div class="fg-title">Execution Timeline</div>
        <div class="fg-rows">
          {nodes.map((node: any) => {
            const widthPercent = Math.max(3, (node.durationMs / totalDuration) * 100);
            const label = node.name.length > 30 ? node.name.substring(0, 27) + "..." : node.name;

            return (
              <div class="fg-row">
                <div class="fg-depth-label">
                  {node.depth === 0 ? "session" : `L${node.depth}`}
                </div>
                <div class="fg-bar-container">
                  <div
                    class={`fg-bar ${node.loopFlag ? "loop" : ""} ${node.isError ? "error" : ""}`}
                    style={{
                      background: getColor(node.kind),
                      width: `${widthPercent}%`,
                    }}
                    title={`${node.name} | ${node.durationMs.toFixed(0)}ms | $${node.costUsd?.toFixed(4) || "0.0000"} | ${node.tokens} tokens | ${node.pctOfTotal?.toFixed(1) || "0"}% of total`}
                  >
                    <span>{label}</span>
                    <span class="fg-tooltip-hint">
                      {node.durationMs.toFixed(0)}ms • ${node.costUsd?.toFixed(4) || "0.0000"}
                    </span>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </>
    )
  }
</div>
