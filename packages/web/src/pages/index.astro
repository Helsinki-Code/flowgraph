  <script>
    function setPricingPeriod(period, button) {
      const buttons = document.querySelectorAll('.toggle-btn');
      buttons.forEach(btn => btn.classList.remove('active'));
      if (button) button.classList.add('active');

      if (period === 'annual') {
        document.getElementById('free-price').textContent = '$0';
        document.getElementById('pro-price').textContent = '$39.20';
        document.getElementById('business-price').textContent = '$239.20';
      } else {
        document.getElementById('free-price').textContent = '$0';
        document.getElementById('pro-price').textContent = '$49';
        document.getElementById('business-price').textContent = '$299';
      }
    }

    document.querySelector('.copy-btn').addEventListener('click', function() {
      const code = document.querySelector('.code-block code').innerText;
      navigator.clipboard.writeText(code).then(() => {
        const btn = this;
        const originalText = btn.innerText;
        btn.innerText = 'Copied!';
        setTimeout(() => {
          btn.innerText = originalText;
        }, 2000);
      });
    });
  </script>
