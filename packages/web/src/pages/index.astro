---
import Public from "../layouts/Public.astro";
---

<Public title="Home" description="See exactly where your AI agent burns tokens. Real-time flame graphs for AI cost optimization.">
  <style>
    .hero {
      padding: var(--spacing-3xl) 0;
      text-align: center;
    }

    .hero h1 {
      font-size: clamp(2rem, 10vw, 3.5rem);
      font-weight: 800;
      margin-bottom: var(--spacing-lg);
      letter-spacing: -0.02em;
      line-height: 1.1;
    }

    .hero p {
      font-size: var(--text-lg);
      color: var(--text-secondary);
      margin-bottom: var(--spacing-lg);
      max-width: 600px;
      margin-left: auto;
      margin-right: auto;
    }

    .hero-ctas {
      display: flex;
      gap: var(--spacing-md);
      justify-content: center;
      flex-wrap: wrap;
    }

    .section {
      padding: var(--spacing-3xl) 0;
      margin-top: var(--spacing-3xl);
      margin-bottom: var(--spacing-3xl);
      border-top: 1px solid var(--border);
    }

    .section h2 {
      text-align: center;
      margin-bottom: var(--spacing-3xl);
    }

    .problem-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: var(--spacing-lg);
    }

    .problem-card {
      background: var(--bg-card);
      padding: var(--spacing-lg);
      border-radius: var(--radius-lg);
      border: 1px solid var(--border);
      transition: all var(--transition-base);
    }

    .problem-card:hover {
      border-color: var(--accent);
      background: var(--bg-surface);
      transform: translateY(-4px);
    }

    .problem-card .icon {
      font-size: 2.5rem;
      margin-bottom: var(--spacing-md);
    }

    .problem-card h3 {
      margin-bottom: var(--spacing-md);
      font-size: var(--text-xl);
      font-weight: 600;
    }

    .problem-card p {
      color: var(--text-secondary);
      font-size: var(--text-sm);
    }

    .steps-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: var(--spacing-lg);
    }

    .step-card {
      background: var(--bg-card);
      padding: var(--spacing-lg);
      border-radius: var(--radius-lg);
      border: 1px solid var(--border);
    }

    .step-number {
      font-size: 2rem;
      font-weight: 700;
      color: var(--accent);
      margin-bottom: var(--spacing-md);
    }

    .step-card h3 {
      margin-bottom: var(--spacing-md);
      font-size: var(--text-base);
      font-weight: 600;
    }

    .step-card code {
      display: block;
      background: var(--bg-surface);
      padding: var(--spacing-md);
      border-radius: var(--radius-sm);
      font-size: var(--text-sm);
      color: var(--success);
      overflow-x: auto;
      margin-bottom: var(--spacing-md);
    }

    .features-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--spacing-lg);
    }

    .feature-item {
      display: flex;
      gap: var(--spacing-lg);
    }

    .feature-icon {
      font-size: 1.5rem;
      flex-shrink: 0;
    }

    .feature-content h3 {
      margin-bottom: var(--spacing-sm);
      font-weight: 600;
    }

    .feature-content p {
      color: var(--text-secondary);
      font-size: var(--text-sm);
    }

    .pricing-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: var(--spacing-lg);
    }

    .pricing-card {
      background: var(--bg-card);
      padding: var(--spacing-lg);
      border-radius: var(--radius-lg);
      border: 1px solid var(--border);
      position: relative;
      transition: all var(--transition-base);
    }

    .pricing-card.featured {
      background: var(--bg-surface);
      border: 2px solid var(--accent);
    }

    .pricing-card.featured:hover {
      box-shadow: 0 0 30px rgba(124, 58, 237, 0.2);
    }

    .pricing-badge {
      position: absolute;
      top: -12px;
      left: 50%;
      transform: translateX(-50%);
      background: var(--accent);
      color: white;
      padding: var(--spacing-xs) var(--spacing-md);
      border-radius: 9999px;
      font-size: var(--text-xs);
      font-weight: 600;
      text-transform: uppercase;
    }

    .pricing-card h3 {
      font-size: var(--text-xl);
      font-weight: 600;
      margin-bottom: var(--spacing-sm);
    }

    .pricing-price {
      font-size: var(--text-lg);
      color: var(--text-secondary);
      margin-bottom: var(--spacing-lg);
    }

    .pricing-price strong {
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--text-primary);
    }

    .pricing-list {
      list-style: none;
      margin-bottom: var(--spacing-lg);
    }

    .pricing-list li {
      padding: var(--spacing-sm) 0;
      color: var(--text-secondary);
      font-size: var(--text-sm);
    }

    .pricing-cta {
      display: block;
      padding: var(--spacing-md);
      border-radius: var(--radius-md);
      text-align: center;
      font-weight: 600;
      font-size: var(--text-sm);
      text-decoration: none;
      transition: all var(--transition-base);
    }

    .pricing-cta-primary {
      background: var(--accent);
      color: white;
    }

    .pricing-cta-primary:hover {
      background: var(--accent-hover);
    }

    .pricing-cta-secondary {
      background: var(--bg-surface);
      color: var(--text-primary);
      border: 1px solid var(--border);
    }

    .pricing-cta-secondary:hover {
      border-color: var(--accent);
      color: var(--text-primary);
    }

    .cta-section {
      padding: var(--spacing-3xl) 0;
      margin-top: var(--spacing-3xl);
      margin-bottom: var(--spacing-3xl);
      text-align: center;
      border-top: 1px solid var(--border);
    }

    .cta-section h2 {
      margin-bottom: var(--spacing-lg);
    }

    .cta-section p {
      color: var(--text-secondary);
      margin-bottom: var(--spacing-lg);
      font-size: var(--text-lg);
    }

    @media (max-width: 768px) {
      .hero h1 {
        font-size: 1.875rem;
      }

      .features-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <div class="container">
    <!-- Hero -->
    <section class="hero">
      <h1>See exactly where your AI agent burns tokens</h1>
      <p>
        Real-time flame graphs identify token waste, runaway loops, and cost overruns in LLM-powered
        systems. Optimize with precision.
      </p>
      <div class="hero-ctas">
        <a href="/sign-up" class="btn btn-primary">Get Started Free</a>
        <a href="/app" class="btn btn-ghost">View Live Demo</a>
      </div>
    </section>

    <!-- Problem -->
    <section class="section">
      <h2>The Problem with LLM Costs</h2>
      <div class="problem-grid">
        <div class="problem-card">
          <div class="icon">📊</div>
          <h3>Wasted Tokens</h3>
          <p>
            70% of token spend is wasted on redundant calls, excessive retries, and unnecessary
            context.
          </p>
        </div>
        <div class="problem-card">
          <div class="icon">🔍</div>
          <h3>No Visibility</h3>
          <p>
            Standard logging gives you timestamps. You need a flame graph to see where tokens
            actually burn.
          </p>
        </div>
        <div class="problem-card">
          <div class="icon">💰</div>
          <h3>Runaway Costs</h3>
          <p>
            Infinite loops and cascading tool calls spiral into hundreds of dollars before anyone
            notices.
          </p>
        </div>
      </div>
    </section>

    <!-- How It Works -->
    <section class="section">
      <h2>How It Works</h2>
      <div class="steps-grid">
        <div class="step-card">
          <div class="step-number">1</div>
          <h3>Install SDK</h3>
          <code>npm install @flamegraph/sdk</code>
        </div>
        <div class="step-card">
          <div class="step-number">2</div>
          <h3>Instrument Agent</h3>
          <code>instrumentAgent(agent, { collector })</code>
        </div>
        <div class="step-card">
          <div class="step-number">3</div>
          <h3>View Flame Graphs</h3>
          <p style="color: var(--text-secondary); font-size: var(--text-sm);">
            Real-time visualization of token burn and cost attribution
          </p>
        </div>
      </div>
    </section>

    <!-- Features -->
    <section class="section">
      <h2>Powerful Features</h2>
      <div class="features-grid">
        <div class="feature-item">
          <div class="feature-icon">🔥</div>
          <div class="feature-content">
            <h3>Flame Graph Visualization</h3>
            <p>
              Time-proportional icicle charts showing exactly where tokens burn across your
              session.
            </p>
          </div>
        </div>
        <div class="feature-item">
          <div class="feature-icon">💳</div>
          <div class="feature-content">
            <h3>Cost Attribution</h3>
            <p>
              Drill down by model, tool, engineer, or feature to find cost hotspots.
            </p>
          </div>
        </div>
        <div class="feature-item">
          <div class="feature-icon">🔁</div>
          <div class="feature-content">
            <h3>Loop Detection</h3>
            <p>
              Automatic detection of infinite loops and cascading tool calls.
            </p>
          </div>
        </div>
        <div class="feature-item">
          <div class="feature-icon">🔔</div>
          <div class="feature-content">
            <h3>Smart Alerts</h3>
            <p>
              Real-time alerts on cost spikes, loops, and unusual patterns.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Pricing Preview -->
    <section class="section">
      <h2>Simple Pricing</h2>
      <div class="pricing-grid">
        <div class="pricing-card">
          <h3>Free</h3>
          <div class="pricing-price">Get started with unlimited sessions</div>
          <ul class="pricing-list">
            <li>✓ Unlimited sessions</li>
            <li>✓ Real-time flame graphs</li>
            <li>✓ Basic alerts</li>
          </ul>
          <a href="/sign-up" class="pricing-cta pricing-cta-secondary">Get Started</a>
        </div>

        <div class="pricing-card featured">
          <div class="pricing-badge">Popular</div>
          <h3>Pro</h3>
          <div class="pricing-price"><strong>$49</strong>/mo</div>
          <ul class="pricing-list">
            <li>✓ 10k sessions/month</li>
            <li>✓ Advanced cost attribution</li>
            <li>✓ Custom alerts & webhooks</li>
            <li>✓ 30-day retention</li>
          </ul>
          <a href="/sign-up" class="pricing-cta pricing-cta-primary">Start Free Trial</a>
        </div>

        <div class="pricing-card">
          <h3>Business</h3>
          <div class="pricing-price"><strong>$299</strong>/mo</div>
          <ul class="pricing-list">
            <li>✓ Unlimited sessions</li>
            <li>✓ Team collaboration</li>
            <li>✓ Priority support</li>
            <li>✓ 90-day retention</li>
          </ul>
          <a href="/sign-up" class="pricing-cta pricing-cta-secondary">Contact Sales</a>
        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="cta-section">
      <h2>Ready to optimize your AI spend?</h2>
      <p>Start for free. No credit card required.</p>
      <a href="/sign-up" class="btn btn-primary btn-lg">Get Started Now</a>
    </section>
  </div>
</Public>
