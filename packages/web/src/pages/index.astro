---
import Dashboard from "../layouts/Dashboard.astro";
import { API_URL } from "../lib/api";

// This will be rendered server-side in production
// In development, fetch from API
const workspaceId = "default";
let sessions = [];
let error = null;

try {
  const response = await fetch(`${API_URL}/v1/sessions?workspace_id=default`);
  const data = await response.json();
  sessions = data.sessions || [];
} catch (e) {
  error = "Failed to load sessions. Make sure the server is running.";
}
---

<Dashboard title="Sessions" description="View and analyze your AI agent session profiles">
  {
    error && (
      <div
        style={{
          padding: "1rem",
          borderRadius: "0.375rem",
          background: "#7f1d1d",
          color: "#fca5a5",
          marginBottom: "1.5rem",
        }}
      >
        {error}
      </div>
    )
  }

  <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fit, minmax(200px, 1fr))", gap: "1rem", marginBottom: "2rem" }}>
    <div style={{ background: "#1e293b", padding: "1.5rem", borderRadius: "0.5rem", border: "1px solid #334155" }}>
      <div style={{ fontSize: "0.875rem", color: "#94a3b8", marginBottom: "0.5rem" }}>
        Total Sessions
      </div>
      <div style={{ fontSize: "2rem", fontWeight: "700" }}>{sessions.length}</div>
    </div>
    <div style={{ background: "#1e293b", padding: "1.5rem", borderRadius: "0.5rem", border: "1px solid #334155" }}>
      <div style={{ fontSize: "0.875rem", color: "#94a3b8", marginBottom: "0.5rem" }}>
        Total Cost
      </div>
      <div style={{ fontSize: "2rem", fontWeight: "700" }}>
        ${sessions.reduce((sum, s) => sum + (s.total_cost_usd || 0), 0).toFixed(2)}
      </div>
    </div>
    <div style={{ background: "#1e293b", padding: "1.5rem", borderRadius: "0.5rem", border: "1px solid #334155" }}>
      <div style={{ fontSize: "0.875rem", color: "#94a3b8", marginBottom: "0.5rem" }}>
        Avg Cost/Session
      </div>
      <div style={{ fontSize: "2rem", fontWeight: "700" }}>
        $
        {sessions.length > 0
          ? (sessions.reduce((sum, s) => sum + (s.total_cost_usd || 0), 0) / sessions.length).toFixed(2)
          : "0.00"}
      </div>
    </div>
  </div>

  <div style={{ background: "#1e293b", borderRadius: "0.5rem", border: "1px solid #334155", overflow: "hidden" }}>
    <div style={{ padding: "1.5rem", borderBottom: "1px solid #334155" }}>
      <h2 style={{ fontSize: "1.25rem", fontWeight: "600" }}>Recent Sessions</h2>
    </div>

    {sessions.length === 0 ? (
      <div style={{ padding: "2rem", textAlign: "center", color: "#94a3b8" }}>
        <p>No sessions yet. Run an agent with flamegraph instrumentation to see results.</p>
      </div>
    ) : (
      <table style={{ width: "100%", borderCollapse: "collapse" }}>
        <thead>
          <tr style={{ borderBottom: "1px solid #334155" }}>
            <th style={{ padding: "1rem", textAlign: "left", color: "#cbd5e1" }}>Session ID</th>
            <th style={{ padding: "1rem", textAlign: "left", color: "#cbd5e1" }}>Feature</th>
            <th style={{ padding: "1rem", textAlign: "left", color: "#cbd5e1" }}>Engineer</th>
            <th style={{ padding: "1rem", textAlign: "right", color: "#cbd5e1" }}>Cost</th>
            <th style={{ padding: "1rem", textAlign: "right", color: "#cbd5e1" }}>Tokens</th>
            <th style={{ padding: "1rem", textAlign: "left", color: "#cbd5e1" }}>Status</th>
          </tr>
        </thead>
        <tbody>
          {sessions.slice(0, 20).map((session) => (
            <tr style={{ borderBottom: "1px solid #334155" }}>
              <td style={{ padding: "1rem" }}>
                <a
                  href={`/sessions/${session.id}`}
                  style={{
                    color: "#3b82f6",
                    textDecoration: "none",
                    fontFamily: "monospace",
                    fontSize: "0.875rem",
                  }}
                >
                  {session.id.slice(0, 12)}...
                </a>
              </td>
              <td style={{ padding: "1rem" }}>{session.feature || "—"}</td>
              <td style={{ padding: "1rem" }}>{session.engineer_id || "—"}</td>
              <td style={{ padding: "1rem", textAlign: "right" }}>
                <span style={{ fontFamily: "monospace" }}>${session.total_cost_usd.toFixed(4)}</span>
              </td>
              <td style={{ padding: "1rem", textAlign: "right" }}>
                <span style={{ fontFamily: "monospace" }}>{session.total_tokens}</span>
              </td>
              <td style={{ padding: "1rem" }}>
                {session.loop_detected ? (
                  <span
                    style={{
                      display: "inline-block",
                      padding: "0.25rem 0.75rem",
                      background: "#f97316",
                      color: "#1e1b4b",
                      borderRadius: "0.25rem",
                      fontSize: "0.75rem",
                      fontWeight: "600",
                    }}
                  >
                    ⚠ LOOP
                  </span>
                ) : (
                  <span style={{ color: "#22c55e" }}>✓ OK</span>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    )}
  </div>
</Dashboard>

<style>
  a {
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }
</style>
