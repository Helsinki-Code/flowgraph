---
import Public from "../layouts/Public.astro";
---

<Public title="Home" description="See exactly where your AI agent burns tokens. Real-time flame graphs for AI cost optimization.">
  <style>
    /* ============================================================================
       HERO SECTION
       ============================================================================ */

    .announcement {
      background: var(--bg-card);
      border-bottom: 1px solid var(--border);
      padding: var(--spacing-md) 0;
      text-align: center;
      font-size: var(--text-sm);
      color: var(--text-secondary);
    }

    .announcement span {
      color: var(--accent);
      font-weight: 600;
    }

    .hero-section {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      padding: var(--spacing-3xl) var(--spacing-lg);
      position: relative;
      overflow: hidden;
    }

    .hero-glow {
      position: absolute;
      width: 500px;
      height: 500px;
      background: radial-gradient(circle, var(--accent-glow) 0%, transparent 70%);
      top: -100px;
      left: 50%;
      transform: translateX(-50%);
      opacity: 0.6;
      pointer-events: none;
      z-index: 0;
    }

    .hero-content {
      position: relative;
      z-index: 2;
      max-width: 800px;
    }

    .beta-badge {
      display: inline-block;
      padding: var(--spacing-xs) var(--spacing-md);
      background: var(--accent-light);
      color: var(--accent);
      border-radius: var(--radius-xl);
      font-size: var(--text-xs);
      font-weight: 700;
      margin-bottom: var(--spacing-lg);
      letter-spacing: 0.05em;
    }

    .hero-title {
      font-size: clamp(2.5rem, 12vw, 4rem);
      font-weight: 800;
      line-height: 1.1;
      margin-bottom: var(--spacing-lg);
      color: var(--text-primary);
    }

    .hero-subtitle {
      font-size: var(--text-lg);
      color: var(--text-secondary);
      line-height: 1.8;
      margin-bottom: var(--spacing-2xl);
      max-width: 700px;
      margin-left: auto;
      margin-right: auto;
    }

    .hero-ctas {
      display: flex;
      gap: var(--spacing-md);
      justify-content: center;
      flex-wrap: wrap;
      margin-bottom: var(--spacing-lg);
    }

    .micro-copy {
      font-size: var(--text-sm);
      color: var(--text-muted);
      margin-bottom: var(--spacing-3xl);
    }

    /* Hero Flame Graph Visualization */
    .hero-visual {
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: var(--spacing-xl);
      max-width: 800px;
      margin-top: var(--spacing-2xl);
    }

    .flame-graph {
      width: 100%;
      height: 300px;
      background: var(--bg-base);
      border-radius: var(--radius-md);
      display: flex;
      align-items: flex-end;
      justify-content: space-around;
      gap: var(--spacing-sm);
      padding: var(--spacing-lg);
      position: relative;
    }

    .flame-bar {
      flex: 1;
      background: linear-gradient(to top, var(--accent-cool), transparent);
      border-radius: var(--radius-sm);
      position: relative;
      min-height: 40px;
      transition: all var(--transition-base);
    }

    .flame-bar:hover {
      filter: brightness(1.2);
    }

    .flame-bar.tool {
      background: linear-gradient(to top, var(--accent), transparent);
    }

    .flame-bar.loop {
      background: linear-gradient(to top, var(--accent-2), transparent);
      box-shadow: 0 0 20px var(--accent-2-glow);
    }

    .flame-bar-label {
      position: absolute;
      bottom: var(--spacing-sm);
      left: 50%;
      transform: translateX(-50%);
      font-size: var(--text-xs);
      color: #e2e8f0;
      font-weight: 600;
      white-space: nowrap;
    }

    .loop-badge {
      position: absolute;
      top: -30px;
      right: 20px;
      background: var(--accent-2);
      color: white;
      padding: var(--spacing-xs) var(--spacing-md);
      border-radius: var(--radius-md);
      font-size: var(--text-xs);
      font-weight: 700;
      animation: pulse-glow 2s ease-in-out infinite;
    }

    .hero-stats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: var(--spacing-lg);
      margin-top: var(--spacing-2xl);
      padding-top: var(--spacing-2xl);
      border-top: 1px solid var(--border);
    }

    .stat-item {
      text-align: center;
    }

    .stat-number {
      font-size: var(--text-2xl);
      font-weight: 800;
      color: var(--accent);
      font-family: 'Monaco', monospace;
    }

    .stat-label {
      font-size: var(--text-xs);
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-top: var(--spacing-xs);
    }

    /* ============================================================================
       LOGO STRIP / SOCIAL PROOF
       ============================================================================ */

    .logo-strip-wrapper {
      background: var(--bg-card);
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
      padding: var(--spacing-lg) 0;
      overflow: hidden;
    }

    .logo-strip-label {
      text-align: center;
      color: var(--text-secondary);
      font-size: var(--text-sm);
      margin-bottom: var(--spacing-md);
    }

    .logo-marquee {
      display: flex;
      gap: var(--spacing-2xl);
      opacity: 0.6;
      animation: marquee 20s linear infinite;
    }

    .logo-marquee:hover {
      animation-play-state: paused;
      opacity: 1;
    }

    .logo-item {
      flex-shrink: 0;
      white-space: nowrap;
      font-weight: 500;
      color: var(--text-secondary);
    }

    @keyframes marquee {
      0% { transform: translateX(0); }
      100% { transform: translateX(-100%); }
    }

    /* ============================================================================
       PROBLEM SECTION
       ============================================================================ */

    .problem-section {
      padding: var(--spacing-3xl) 0;
    }

    .problem-headline {
      text-align: center;
      font-size: var(--text-3xl);
      font-weight: 700;
      margin-bottom: var(--spacing-3xl);
      color: var(--text-primary);
    }

    .problem-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: var(--spacing-lg);
    }

    .problem-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: var(--spacing-2xl);
      text-align: center;
      transition: all var(--transition-base);
    }

    .problem-card:hover {
      border-color: var(--accent);
      background: var(--bg-surface);
      transform: translateY(-4px);
    }

    .problem-stat {
      font-size: 3rem;
      font-weight: 800;
      color: var(--accent);
      margin-bottom: var(--spacing-md);
      font-family: 'Monaco', monospace;
    }

    .problem-card h3 {
      font-size: var(--text-xl);
      margin-bottom: var(--spacing-md);
    }

    .problem-card p {
      color: var(--text-secondary);
      font-size: var(--text-sm);
    }

    /* ============================================================================
       FEATURE SECTIONS (01, 02, 03)
       ============================================================================ */

    .feature-section {
      padding: var(--spacing-3xl) 0;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--spacing-3xl);
      align-items: center;
    }

    .feature-section.reverse {
      direction: rtl;
    }

    .feature-section.reverse > * {
      direction: ltr;
    }

    .feature-number {
      font-size: 4rem;
      font-weight: 800;
      color: var(--accent);
      opacity: 0.2;
      margin-bottom: var(--spacing-lg);
    }

    .feature-content h2 {
      font-size: var(--text-2xl);
      margin-bottom: var(--spacing-lg);
    }

    .feature-content p {
      color: var(--text-secondary);
      line-height: 1.8;
      margin-bottom: var(--spacing-lg);
    }

    .feature-visual {
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: var(--spacing-xl);
      min-height: 300px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--text-muted);
    }

    /* ============================================================================
       CODE SNIPPET SECTION
       ============================================================================ */

    .code-section {
      padding: var(--spacing-3xl) 0;
      text-align: center;
    }

    .code-headline {
      font-size: var(--text-2xl);
      font-weight: 700;
      margin-bottom: var(--spacing-lg);
    }

    .code-container {
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      max-width: 600px;
      margin: var(--spacing-2xl) auto;
      overflow: hidden;
    }

    .code-header {
      background: var(--bg-card);
      padding: var(--spacing-md) var(--spacing-lg);
      border-bottom: 1px solid var(--border);
      display: flex;
      gap: var(--spacing-sm);
      align-items: center;
    }

    .code-dot {
      width: 12px;
      height: 12px;
      border-radius: 50%;
    }

    .code-dot.red { background: #ef4444; }
    .code-dot.yellow { background: #f59e0b; }
    .code-dot.green { background: #22c55e; }

    .code-path {
      font-size: var(--text-xs);
      color: var(--text-muted);
      margin-left: auto;
      font-family: monospace;
    }

    .code-block {
      padding: var(--spacing-lg);
    }

    .code-block code {
      display: block;
      font-family: 'Monaco', 'Menlo', monospace;
      font-size: var(--text-sm);
      line-height: 1.8;
      color: #e2e8f0;
      text-align: left;
      white-space: pre;
      overflow-x: auto;
    }

    .code-comment {
      color: #888;
    }

    .copy-btn {
      display: inline-block;
      margin-top: var(--spacing-md);
      padding: var(--spacing-sm) var(--spacing-lg);
      background: var(--accent);
      color: white;
      border: none;
      border-radius: var(--radius-md);
      font-size: var(--text-sm);
      font-weight: 600;
      cursor: pointer;
      transition: all var(--transition-base);
    }

    .copy-btn:hover {
      background: var(--accent-hover);
    }

    .code-tagline {
      color: var(--text-muted);
      font-size: var(--text-sm);
      margin-top: var(--spacing-md);
    }

    /* ============================================================================
       PRICING SECTION
       ============================================================================ */

    .pricing-section {
      padding: var(--spacing-3xl) 0;
    }

    .pricing-header {
      text-align: center;
      margin-bottom: var(--spacing-2xl);
    }

    .toggle-group {
      display: flex;
      justify-content: center;
      gap: var(--spacing-md);
      margin-bottom: var(--spacing-2xl);
    }

    .toggle-btn {
      padding: var(--spacing-sm) var(--spacing-lg);
      background: var(--bg-card);
      color: var(--text-secondary);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      cursor: pointer;
      transition: all var(--transition-base);
    }

    .toggle-btn.active {
      background: var(--accent);
      color: white;
      border-color: var(--accent);
    }

    .pricing-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: var(--spacing-lg);
    }

    .pricing-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: var(--spacing-2xl);
      position: relative;
      transition: all var(--transition-base);
    }

    .pricing-card.featured {
      background: var(--bg-surface);
      border: 2px solid var(--accent);
      transform: scale(1.02);
    }

    .pricing-badge {
      position: absolute;
      top: -12px;
      left: 50%;
      transform: translateX(-50%);
      background: var(--accent);
      color: white;
      padding: var(--spacing-xs) var(--spacing-lg);
      border-radius: var(--radius-xl);
      font-size: var(--text-xs);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .pricing-card h3 {
      font-size: var(--text-xl);
      margin-bottom: var(--spacing-md);
    }

    .pricing-desc {
      color: var(--text-secondary);
      font-size: var(--text-sm);
      margin-bottom: var(--spacing-lg);
    }

    .pricing-amount {
      font-size: 2.5rem;
      font-weight: 800;
      color: var(--text-primary);
      margin-bottom: var(--spacing-lg);
      font-family: 'Monaco', monospace;
    }

    .pricing-amount span {
      font-size: var(--text-base);
      color: var(--text-secondary);
    }

    .pricing-list {
      list-style: none;
      margin-bottom: var(--spacing-lg);
    }

    .pricing-list li {
      padding: var(--spacing-sm) 0;
      color: var(--text-secondary);
      font-size: var(--text-sm);
      border-bottom: 1px solid var(--border);
    }

    .pricing-list li:last-child {
      border-bottom: none;
    }

    .pricing-cta {
      display: block;
      padding: var(--spacing-md);
      border: none;
      border-radius: var(--radius-md);
      text-align: center;
      font-weight: 600;
      text-decoration: none;
      cursor: pointer;
      transition: all var(--transition-base);
      background: var(--bg-surface);
      color: var(--text-primary);
      border: 1px solid var(--border);
    }

    .pricing-cta.primary {
      background: var(--accent);
      color: white;
      border-color: var(--accent);
    }

    .pricing-cta:hover {
      transform: translateY(-2px);
    }

    /* ============================================================================
       TESTIMONIALS SECTION
       ============================================================================ */

    .testimonial-section {
      padding: var(--spacing-3xl) 0;
    }

    .testimonial-headline {
      text-align: center;
      font-size: var(--text-2xl);
      font-weight: 700;
      margin-bottom: var(--spacing-3xl);
    }

    .testimonial-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: var(--spacing-lg);
    }

    .testimonial-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: var(--spacing-2xl);
    }

    .testimonial-quote {
      font-size: var(--text-base);
      color: var(--text-secondary);
      line-height: 1.8;
      margin-bottom: var(--spacing-lg);
      font-style: italic;
    }

    .testimonial-author {
      font-weight: 600;
      color: var(--text-primary);
      margin-bottom: var(--spacing-xs);
    }

    .testimonial-role {
      font-size: var(--text-sm);
      color: var(--text-muted);
    }

    /* ============================================================================
       FINAL CTA SECTION
       ============================================================================ */

    .cta-section {
      padding: var(--spacing-3xl) 0;
      background: linear-gradient(135deg, var(--accent) 0%, var(--accent-2) 100%);
      border-radius: var(--radius-lg);
      text-align: center;
      color: white;
    }

    .cta-headline {
      font-size: var(--text-2xl);
      font-weight: 700;
      margin-bottom: var(--spacing-lg);
    }

    .cta-btn {
      display: inline-block;
      padding: var(--spacing-lg) var(--spacing-2xl);
      background: white;
      color: var(--accent);
      border: none;
      border-radius: var(--radius-md);
      font-size: var(--text-base);
      font-weight: 700;
      cursor: pointer;
      transition: all var(--transition-base);
      margin-bottom: var(--spacing-md);
    }

    .cta-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    }

    .cta-micro {
      font-size: var(--text-sm);
      opacity: 0.9;
    }

    /* ============================================================================
       RESPONSIVE
       ============================================================================ */

    @media (max-width: 768px) {
      .hero-section {
        min-height: auto;
        padding: var(--spacing-2xl) var(--spacing-md);
      }

      .hero-title {
        font-size: 2rem;
      }

      .feature-section {
        grid-template-columns: 1fr;
        gap: var(--spacing-2xl);
      }

      .feature-section.reverse {
        direction: ltr;
      }

      .feature-number {
        font-size: 2.5rem;
      }

      .problem-card {
        padding: var(--spacing-lg);
      }

      .pricing-card.featured {
        transform: scale(1);
      }

      .hero-stats {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <div class="container">
    <!-- Announcement Banner -->
    <div class="announcement">
      ðŸ”¥ <span>Now in public beta</span> â€” Sign up free, no credit card required
    </div>

    <!-- Hero Section -->
    <section class="hero-section">
      <div class="hero-glow"></div>
      <div class="hero-content">
        <div class="beta-badge">ðŸ”¥ Public Beta Â· Free to start</div>
        <h1 class="hero-title">See exactly where your AI agent burns tokens</h1>
        <p class="hero-subtitle">
          Token Flame Graph gives you real-time flame graphs for every AI agent session â€” identify runaway loops, wasted context, and cost spikes before they wreck your bill.
        </p>
        <div class="hero-ctas">
          <a href="/sign-up" class="btn btn-primary btn-lg">Get Started Free â†’</a>
          <a href="#features" class="btn btn-ghost btn-lg">See how it works â†“</a>
        </div>
        <div class="micro-copy">Free for 10K spans/day Â· No credit card required</div>

        <!-- Hero Flame Graph Visualization -->
        <div class="hero-visual">
          <svg viewBox="0 0 800 300" class="flame-graph" style="display: none;">
