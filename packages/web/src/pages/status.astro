---
import Public from "../layouts/Public.astro";
---

<Public title="Status" description="Current Token Flame Graph service status.">
  <div class="container" style="max-width: 900px; padding: 4rem 1rem;">
    <h1 style="margin-bottom: 1rem;">System Status</h1>
    <p style="color: var(--text-secondary); margin-bottom: 2rem;">
      Operational status and incident communication for web and API services.
    </p>
    <div class="card" style="padding: 1.5rem;">
      <h2 style="margin-bottom: 0.5rem;">Current Status: Operational</h2>
      <p style="margin: 0; color: var(--text-secondary);">
        For active incidents, updates are posted here and shared via support channels.
      </p>
    </div>
  </div>
</Public>
