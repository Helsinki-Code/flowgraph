---
import Public from "../layouts/Public.astro";
---

<Public title="Documentation" description="Get started with the Flame Graph SDK in minutes.">
  <style>
    .docs-container {
      max-width: 900px;
      margin: 0 auto;
      padding: var(--spacing-3xl) 0;
    }

    .docs-header {
      margin-bottom: var(--spacing-3xl);
    }

    .docs-header h1 {
      font-size: clamp(2rem, 10vw, 2.5rem);
      margin-bottom: var(--spacing-md);
    }

    .docs-header p {
      color: var(--text-secondary);
      font-size: var(--text-lg);
    }

    .docs-section {
      margin-bottom: var(--spacing-3xl);
      padding-bottom: var(--spacing-lg);
      border-bottom: 1px solid var(--border);
    }

    .docs-section h2 {
      font-size: var(--text-3xl);
      font-weight: 700;
      margin-bottom: var(--spacing-md);
    }

    .docs-section p {
      color: var(--text-secondary);
      margin-bottom: var(--spacing-lg);
    }

    .docs-section h3 {
      font-size: var(--text-xl);
      font-weight: 600;
      margin-top: var(--spacing-lg);
      margin-bottom: var(--spacing-md);
    }

    .docs-code {
      background: var(--bg-surface);
      padding: var(--spacing-lg);
      border-radius: var(--radius-lg);
      overflow-x: auto;
      margin-bottom: var(--spacing-lg);
      border: 1px solid var(--border);
    }

    .docs-code code {
      color: #e2e8f0;
      font-family: 'Monaco', 'Menlo', 'Ubuntu Mono', monospace;
      font-size: var(--text-sm);
      line-height: 1.5;
    }

    .docs-code.shell code {
      color: var(--success);
    }

    .docs-list {
      list-style: none;
      color: var(--text-secondary);
    }

    .docs-list li {
      padding: var(--spacing-sm) 0;
    }

    .docs-list strong {
      color: var(--text-primary);
      font-weight: 600;
    }

    .docs-list.numbered {
      list-style: decimal;
      padding-left: var(--spacing-xl);
    }

    .docs-list.numbered li {
      padding: var(--spacing-md) 0;
      color: var(--text-secondary);
    }

    .support-box {
      background: var(--bg-card);
      padding: var(--spacing-lg);
      border-radius: var(--radius-lg);
      border: 1px solid var(--border);
    }

    .support-box h3 {
      margin-bottom: var(--spacing-md);
      margin-top: 0;
    }

    .support-box p {
      margin-bottom: var(--spacing-md);
    }

    .support-links {
      display: flex;
      gap: var(--spacing-lg);
      flex-wrap: wrap;
    }

    .support-links a {
      color: var(--accent);
      text-decoration: none;
      font-weight: 600;
    }

    .support-links a:hover {
      color: var(--accent-hover);
    }

    @media (max-width: 768px) {
      .docs-container {
        padding: var(--spacing-lg) 0;
      }

      .docs-section h2 {
        font-size: var(--text-2xl);
      }
    }
  </style>

  <div class="container docs-container">
    <section class="docs-header">
      <h1>Documentation</h1>
      <p>Learn how to instrument your AI agent and start tracking token consumption.</p>
    </section>

    <!-- Installation -->
    <section class="docs-section">
      <h2>Installation</h2>
      <p>Install the Flame Graph SDK from npm:</p>
      <div class="docs-code shell">
        <code>npm install @flamegraph/sdk</code>
      </div>
    </section>

    <!-- Quick Start -->
    <section class="docs-section">
      <h2>Quick Start</h2>
      <p>Wrap your agent with instrumentation in 3 lines:</p>
      <div class="docs-code">
        <code>{`import { instrumentAgent } from "@flamegraph/sdk";
import { LocalCollector } from "@flamegraph/sdk";

// Create collector that posts to Flame Graph server
const collector = new LocalCollector({
  serverUrl: "https://flowgraph-n8xj.onrender.com",
  apiKey: "sk_...", // Get from dashboard
});

// Wrap your agent
instrumentAgent(agent, { collector });

// Events automatically flow to the dashboard
await agent.run("What's the weather?");`}</code>
      </div>
    </section>

    <!-- Configuration -->
    <section class="docs-section">
      <h2>Configuration</h2>
      <p>LocalCollector accepts these options:</p>
      <ul class="docs-list">
        <li><strong>serverUrl</strong> (required) - URL to your Flame Graph server</li>
        <li><strong>apiKey</strong> (optional) - API key from dashboard (for authentication)</li>
        <li><strong>flushInterval</strong> - How often to batch-send events (default: 5000ms)</li>
        <li><strong>maxBatchSize</strong> - Events per batch (default: 100)</li>
      </ul>
    </section>

    <!-- API Reference -->
    <section class="docs-section">
      <h2>API Reference</h2>

      <h3>instrumentAgent(agent, options)</h3>
      <p>Wraps an agent to track all LLM calls, tool executions, and context builds.</p>
      <div class="docs-code">
        <code>{`instrumentAgent(agent, {
  collector: LocalCollector,
  workspaceId?: string,
  engineerId?: string,
  feature?: string,
});`}</code>
      </div>

      <h3>collector.flush()</h3>
      <p>Manually flush buffered events to the server. Called automatically at intervals.</p>
    </section>

    <!-- Getting Your API Key -->
    <section class="docs-section">
      <h2>Getting Your API Key</h2>
      <ol class="docs-list numbered">
        <li>Sign in to your Flame Graph dashboard</li>
        <li>Go to Settings → API Keys</li>
        <li>Click "Generate New Key" and copy it</li>
        <li>Pass it to LocalCollector as <code>apiKey</code></li>
      </ol>
    </section>

    <!-- Examples -->
    <section class="docs-section">
      <h2>Examples</h2>

      <h3>With a pi-agent core agent</h3>
      <div class="docs-code">
        <code>{`import { createAgent } from "pi-agent-core";
import { instrumentAgent, LocalCollector } from "@flamegraph/sdk";

const agent = createAgent({...});

const collector = new LocalCollector({
  serverUrl: "https://api.flamegraph.dev",
  apiKey: process.env.FLAMEGRAPH_API_KEY,
});

instrumentAgent(agent, {
  collector,
  feature: "market-research",
  engineerId: "john@company.com",
});

await agent.run("Research competitors...");`}</code>
      </div>
    </section>

    <!-- Support -->
    <section class="support-box" style="margin-bottom: var(--spacing-3xl);">
      <h3>Need Help?</h3>
      <p>Check our GitHub discussions, open an issue, or email support@flamegraph.dev</p>
      <div class="support-links">
        <a href="https://github.com/Helsinki-Code/flowgraph/discussions">GitHub</a>
        <a href="mailto:support@flamegraph.dev">Email</a>
      </div>
    </section>
  </div>
</Public>
