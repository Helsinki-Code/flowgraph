---
export const prerender = false;

import Dashboard from "../../layouts/Dashboard.astro";
import { API_URL } from "../../lib/api";

let userId, orgId, token;
try {
  if (!Astro.locals?.auth) {
    return Astro.redirect("/sign-in");
  }

  const auth = Astro.locals.auth();
  userId = auth?.userId;
  orgId = auth?.orgId;
  token = auth?.getToken ? await auth.getToken() : null;

  if (!userId) {
    return Astro.redirect("/sign-in");
  }
} catch (e) {
  console.error("Auth error in /app/alerts:", e);
  return Astro.redirect("/sign-in");
}

const workspaceId = orgId || userId;
let alerts = [];
let error = null;

if (workspaceId && token) {
  try {
    const response = await fetch(`${API_URL}/v1/alerts?workspace_id=${workspaceId}`, {
      headers: { "Authorization": `Bearer ${token}` },
    });
    if (!response.ok) {
      error = `API Error: ${response.status} ${response.statusText}`;
    } else {
      const data = await response.json();
      alerts = data.alerts || [];
    }
  } catch (e: any) {
    error = `Failed to load alerts: ${e.message}`;
  }
} else {
  error = "Missing authentication data";
}
---

<Dashboard title="Alerts" description="Set up cost and loop detection alerts">
  {error && <div style={{ padding: "1rem", background: "#7f1d1d", color: "#fca5a5", borderRadius: "0.375rem", marginBottom: "1.5rem" }}>{error}</div>}

  <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: "2rem", marginBottom: "3rem" }}>
    <div style={{ background: "#1e293b", padding: "1.5rem", borderRadius: "0.5rem", border: "1px solid #334155" }}>
      <h3 style={{ fontSize: "1.1rem", fontWeight: "600", marginBottom: "1rem" }}>Create Alert</h3>
      <form id="alert-form" style={{ display: "flex", flexDirection: "column", gap: "1rem" }}>
        <input type="text" placeholder="Alert name" style={{ padding: "0.75rem", background: "#0f172a", border: "1px solid #334155", borderRadius: "0.375rem", color: "#fafafa" }} name="name" required />
        <select name="condition" style={{ padding: "0.75rem", background: "#0f172a", border: "1px solid #334155", borderRadius: "0.375rem", color: "#fafafa" }}>
          <option value="cost_spike">Cost spike (>$10/session)</option>
          <option value="token_excess">Token excess (>100k tokens)</option>
          <option value="loop_detected">Loop detected</option>
          <option value="custom">Custom</option>
        </select>
        <input type="email" placeholder="Email" style={{ padding: "0.75rem", background: "#0f172a", border: "1px solid #334155", borderRadius: "0.375rem", color: "#fafafa" }} name="email" />
        <button type="submit" style={{ padding: "0.75rem", background: "#6366f1", color: "white", border: "none", borderRadius: "0.375rem", fontWeight: "600", cursor: "pointer" }}>Create Alert</button>
      </form>
    </div>

    <div style={{ background: "#1e293b", padding: "1.5rem", borderRadius: "0.5rem", border: "1px solid #334155" }}>
      <h3 style={{ fontSize: "1.1rem", fontWeight: "600", marginBottom: "1rem" }}>Active Alerts</h3>
      {alerts.length === 0 ? (
        <p style={{ color: "#94a3b8" }}>No alerts configured yet.</p>
      ) : (
        <ul style={{ listStyle: "none" }}>
          {alerts.map((alert: any) => (
            <li style={{ paddingY: "0.5rem", borderBottom: "1px solid #334155", display: "flex", justifyContent: "space-between" }}>
              <div>
                <div style={{ fontWeight: "600" }}>{alert.name}</div>
                <div style={{ fontSize: "0.85rem", color: "#94a3b8" }}>{alert.condition}</div>
              </div>
              <button style={{ background: "transparent", border: "none", color: "#ef4444", cursor: "pointer", padding: 0 }} onclick={`deleteAlert('${alert.id}')`}>×</button>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>

  <script define:vars={{ token, workspaceId, API_URL }}>
    document.getElementById("alert-form")?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const form = e.target;
      const data = {
        name: form.name.value,
        condition: form.condition.value,
        email: form.email.value,
      };
      try {
        const res = await fetch(`${API_URL}/v1/alerts`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "Authorization": `Bearer ${token}`,
          },
          body: JSON.stringify(data),
        });
        if (res.ok) {
          location.reload();
        }
      } catch (err) {
        alert("Failed to create alert");
      }
    });

    async function deleteAlert(id) {
      if (!confirm("Delete this alert?")) return;
      try {
        const res = await fetch(`${API_URL}/v1/alerts/${id}`, {
          method: "DELETE",
          headers: { "Authorization": `Bearer ${token}` },
        });
        if (res.ok) {
          location.reload();
        }
      } catch (err) {
        alert("Failed to delete alert");
      }
    }
  </script>
</Dashboard>
