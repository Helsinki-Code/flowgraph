---
export const prerender = false;

import Dashboard from "../../layouts/Dashboard.astro";
import { API_URL } from "../../lib/api";
import { fetchJsonWithTimeout, isApiHealthy } from "../../lib/server-fetch";

let userId, orgId, token;
try {
  if (!Astro.locals?.auth) {
    return Astro.redirect("/sign-in");
  }

  const auth = Astro.locals.auth();
  userId = auth?.userId;
  orgId = auth?.orgId;
  token = auth?.getToken ? await auth.getToken() : null;

  if (!userId) {
    return Astro.redirect("/sign-in");
  }
} catch (e) {
  console.error("Auth error in /app:", e);
  return Astro.redirect("/sign-in");
}

const workspaceId = orgId || userId;
let sessions: any[] = [];
let error: string | null = null;
let apiDegraded = false;

if (workspaceId && token) {
  try {
    const data = await fetchJsonWithTimeout<{ sessions: any[] }>(`${API_URL}/v1/sessions?limit=20`, {
      headers: {
        Authorization: `Bearer ${token}`,
      },
      timeoutMs: 8000,
      retries: 1,
    });
    sessions = data.sessions || [];
  } catch (e: any) {
    apiDegraded = !(await isApiHealthy(API_URL));
    error = apiDegraded
      ? "The API service is temporarily unavailable. Please retry in a few seconds."
      : `Failed to load sessions: ${e.message}`;
  }
} else {
  error = "Missing authentication data";
}

const totalCost = sessions.reduce((sum: number, s: any) => sum + (s.total_cost_usd || 0), 0);
const avgCost = sessions.length > 0 ? totalCost / sessions.length : 0;
const totalTokens = sessions.reduce((sum: number, s: any) => sum + (s.total_tokens || 0), 0);
---

<style>
  .error-banner {
    padding: 1rem 1.1rem;
    border-radius: 0.75rem;
    background: var(--danger-bg);
    color: var(--danger-text);
    border: 1px solid var(--danger-border);
    margin-bottom: 1rem;
  }

  .hero {
    border: 1px solid var(--panel-border);
    border-radius: 1rem;
    padding: 1rem;
    background:
      radial-gradient(circle at 12% 8%, rgba(249, 115, 22, 0.18), transparent 34%),
      radial-gradient(circle at 84% 18%, rgba(14, 165, 233, 0.17), transparent 36%),
      var(--panel-bg);
    margin-bottom: 1rem;
  }

  .hero-title {
    margin: 0;
    font-family: "Bricolage Grotesque", sans-serif;
    font-size: clamp(1.1rem, 2.4vw, 1.6rem);
    letter-spacing: -0.02em;
  }

  .hero-subtitle {
    margin: 0.45rem 0 0;
    color: var(--text-subtle);
    max-width: 60ch;
    font-size: 0.92rem;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.9rem;
    margin-bottom: 1rem;
  }

  .stat-card {
    background: var(--panel-bg);
    border: 1px solid var(--panel-border);
    border-radius: 0.9rem;
    padding: 1rem;
    position: relative;
    overflow: hidden;
  }

  .stat-card::after {
    content: "";
    position: absolute;
    inset: auto -32% -72% auto;
    width: 170px;
    height: 170px;
    background: radial-gradient(circle, rgba(249, 115, 22, 0.2), transparent 62%);
    pointer-events: none;
  }

  .stat-label {
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.74rem;
    font-weight: 700;
  }

  .stat-value {
    margin-top: 0.38rem;
    color: var(--text-main);
    font-family: "JetBrains Mono", monospace;
    font-weight: 700;
    font-size: clamp(1rem, 2.2vw, 1.35rem);
  }

  .sessions-card {
    background: var(--panel-bg);
    border: 1px solid var(--panel-border);
    border-radius: 1rem;
    overflow: hidden;
  }

  .sessions-head {
    padding: 1rem;
    border-bottom: 1px solid var(--panel-border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.65rem;
  }

  .sessions-head h2 {
    margin: 0;
    font-size: 1rem;
    font-family: "Bricolage Grotesque", sans-serif;
  }

  .compare-link {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--line-strong);
    background: var(--surface-1);
    color: var(--text-main);
    text-decoration: none;
    padding: 0.45rem 0.7rem;
    border-radius: 0.55rem;
    font-size: 0.78rem;
    font-weight: 700;
  }

  .compare-link:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
  }

  thead th {
    padding: 0.8rem 1rem;
    text-align: left;
    color: var(--text-dim);
    background: var(--surface-1);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: 0.72rem;
  }

  tbody td {
    padding: 0.82rem 1rem;
    color: var(--text-subtle);
    border-bottom: 1px solid var(--panel-border);
  }

  tbody tr:hover {
    background: rgba(249, 115, 22, 0.08);
  }

  .session-link {
    text-decoration: none;
    color: var(--text-main);
    font-family: "JetBrains Mono", monospace;
    font-size: 0.82rem;
    font-weight: 600;
  }

  .session-link:hover {
    color: var(--accent);
  }

  .status-ok {
    color: var(--success-text);
    font-weight: 700;
    font-size: 0.75rem;
  }

  .status-loop {
    color: var(--danger-text);
    background: var(--danger-bg);
    border: 1px solid var(--danger-border);
    border-radius: 999px;
    padding: 0.2rem 0.52rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .empty-state {
    padding: 2rem 1.2rem;
  }

  .empty-state h3 {
    margin: 0;
    font-family: "Bricolage Grotesque", sans-serif;
  }

  .empty-state p {
    margin: 0.5rem 0 1rem;
    color: var(--text-subtle);
    max-width: 64ch;
  }

  .pulse-lanes {
    height: 8rem;
    border-radius: 0.8rem;
    border: 1px solid var(--panel-border);
    background: var(--surface-3);
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 0.35rem;
    align-items: end;
    padding: 0.6rem;
    margin-bottom: 1rem;
  }

  .pulse-bar {
    border-radius: 0.32rem;
    animation: pulseHeight 2.8s ease-in-out infinite;
  }

  .pulse-bar:nth-child(3n) { background: #7c3aed; }
  .pulse-bar:nth-child(3n+1) { background: #f59e0b; }
  .pulse-bar:nth-child(3n+2) { background: #ef4444; }

  @keyframes pulseHeight {
    0%, 100% { transform: scaleY(0.7); }
    50% { transform: scaleY(1); }
  }

  .cta-row {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .cta-btn {
    border: 1px solid transparent;
    border-radius: 0.6rem;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.82rem;
    padding: 0.52rem 0.86rem;
    display: inline-flex;
    align-items: center;
  }

  .cta-btn.primary {
    background: var(--accent);
    color: #fff;
  }

  .cta-btn.primary:hover {
    background: var(--accent-strong);
  }

  .cta-btn.secondary {
    background: var(--surface-1);
    border-color: var(--line-strong);
    color: var(--text-main);
  }

  .cta-btn.secondary:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  @media (max-width: 920px) {
    .stats-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 720px) {
    .stats-grid {
      grid-template-columns: 1fr;
    }

    .sessions-head {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

<Dashboard title="Sessions" description="Track every run, cost spike, and loop with one control view.">
  {error && (
    <div class="error-banner">
      {error}
      {apiDegraded && <div style={{ marginTop: "0.35rem", fontSize: "0.82rem" }}>Health check reports API cold or unavailable.</div>}
    </div>
  )}

  <section class="hero">
    <h2 class="hero-title">Session Command Surface</h2>
    <p class="hero-subtitle">
      This board surfaces run economics and reliability signals in one pass so you can spot costly regressions before deploy.
    </p>
  </section>

  <section class="stats-grid">
    <article class="stat-card">
      <div class="stat-label">Sessions</div>
      <div class="stat-value">{sessions.length.toLocaleString()}</div>
    </article>
    <article class="stat-card">
      <div class="stat-label">Total Cost (USD)</div>
      <div class="stat-value">${totalCost.toFixed(4)}</div>
    </article>
    <article class="stat-card">
      <div class="stat-label">Average Cost</div>
      <div class="stat-value">${avgCost.toFixed(4)}</div>
    </article>
  </section>

  <section class="sessions-card">
    <div class="sessions-head">
      <h2>Recent Sessions</h2>
      {sessions.length >= 2 && (
        <a class="compare-link" href="/app/sessions/diff">Compare Runs</a>
      )}
    </div>

    {sessions.length === 0 ? (
      <div class="empty-state">
        <h3>No sessions yet</h3>
        <p>Instrument your PI agent with `flamegraph-sdk` and the first run will appear here instantly.</p>
        <div class="pulse-lanes">
          {Array.from({ length: 12 }).map((_, idx) => (
            <div class="pulse-bar" style={{ height: `${42 + (idx % 5) * 10}%`, animationDelay: `${idx * 0.08}s` }}></div>
          ))}
        </div>
        <div class="cta-row">
          <a class="cta-btn primary" href="/app/settings">Get API Key</a>
          <a class="cta-btn secondary" href="/docs">Read Docs</a>
        </div>
      </div>
    ) : (
      <div style={{ overflowX: "auto" }}>
        <table>
          <thead>
            <tr>
              <th>Session</th>
              <th>Feature</th>
              <th>Duration</th>
              <th>Cost</th>
              <th>Tokens</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            {sessions.map((session: any) => {
              const durationSec = Math.max(0, Math.round(((session.ended_at || session.started_at) - session.started_at) / 1000));
              return (
                <tr>
                  <td>
                    <a class="session-link" href={`/app/sessions/${session.id}`}>{session.id.slice(0, 12)}...</a>
                  </td>
                  <td>{session.feature || "-"}</td>
                  <td>{durationSec}s</td>
                  <td>${session.total_cost_usd.toFixed(4)}</td>
                  <td>{(session.total_tokens || 0).toLocaleString()}</td>
                  <td>
                    {session.loop_detected ? (
                      <span class="status-loop">Loop</span>
                    ) : (
                      <span class="status-ok">Healthy</span>
                    )}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    )}
  </section>
</Dashboard>
