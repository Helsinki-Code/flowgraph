---
export const prerender = false;

import Dashboard from "../../layouts/Dashboard.astro";
import { API_URL } from "../../lib/api";

let userId, orgId, token;
try {
  // Ensure auth exists before calling it
  if (!Astro.locals?.auth) {
    return Astro.redirect("/sign-in");
  }

  const auth = Astro.locals.auth();
  userId = auth?.userId;
  orgId = auth?.orgId;
  token = auth?.getToken ? await auth.getToken() : null;

  if (!userId) {
    return Astro.redirect("/sign-in");
  }
} catch (e) {
  console.error("Auth error in /app:", e);
  return Astro.redirect("/sign-in");
}

const workspaceId = orgId || userId;
let sessions = [];
let error = null;

if (workspaceId && token) {
  try {
    const response = await fetch(`${API_URL}/v1/sessions?workspace_id=${workspaceId}&limit=20`, {
      headers: {
        "Authorization": `Bearer ${token}`,
      },
    });
    if (!response.ok) {
      error = `API Error: ${response.status} ${response.statusText}`;
    } else {
      const data = await response.json();
      sessions = data.sessions || [];
    }
  } catch (e: any) {
    error = `Failed to load sessions: ${e.message}`;
  }
} else {
  error = "Missing authentication data";
}

const totalCost = sessions.reduce((sum: number, s: any) => sum + (s.total_cost_usd || 0), 0);
const avgCost = sessions.length > 0 ? totalCost / sessions.length : 0;
---

<style>
  @keyframes flamePulse {
    0%, 100% {
      transform: scaleY(1);
    }
    50% {
      transform: scaleY(0.93);
    }
  }
</style>

<Dashboard title="Sessions" description="View and analyze your AI agent session profiles">
  {
    error && (
      <div
        style={{
          padding: "1rem",
          borderRadius: "0.375rem",
          background: "#7f1d1d",
          color: "#fca5a5",
          marginBottom: "1.5rem",
        }}
      >
        {error}
      </div>
    )
  }

  <div
    style={{
      display: "grid",
      gridTemplateColumns: "repeat(auto-fit, minmax(200px, 1fr))",
      gap: "1rem",
      marginBottom: "2rem",
    }}
  >
    <div style={{ background: "#1e293b", padding: "1.5rem", borderRadius: "0.5rem", border: "1px solid #334155" }}>
      <div style={{ fontSize: "0.875rem", color: "#94a3b8", textTransform: "uppercase", marginBottom: "0.5rem" }}>
        Total Sessions
      </div>
      <div style={{ fontSize: "2rem", fontWeight: "700" }}>{sessions.length}</div>
    </div>
    <div style={{ background: "#1e293b", padding: "1.5rem", borderRadius: "0.5rem", border: "1px solid #334155" }}>
      <div style={{ fontSize: "0.875rem", color: "#94a3b8", textTransform: "uppercase", marginBottom: "0.5rem" }}>
        Total Cost
      </div>
      <div style={{ fontSize: "2rem", fontWeight: "700" }}>${totalCost.toFixed(4)}</div>
    </div>
    <div style={{ background: "#1e293b", padding: "1.5rem", borderRadius: "0.5rem", border: "1px solid #334155" }}>
      <div style={{ fontSize: "0.875rem", color: "#94a3b8", textTransform: "uppercase", marginBottom: "0.5rem" }}>
        Avg Cost/Session
      </div>
      <div style={{ fontSize: "2rem", fontWeight: "700" }}>${avgCost.toFixed(4)}</div>
    </div>
  </div>

  <div style={{ background: "#1e293b", borderRadius: "0.5rem", border: "1px solid #334155", overflow: "hidden" }}>
    <div style={{ padding: "1.5rem", borderBottom: "1px solid #334155" }}>
      <h2 style={{ fontSize: "1.1rem", fontWeight: "600" }}>Recent Sessions</h2>
    </div>
    {sessions.length === 0 ? (
      <div style={{ background: "#1e293b", borderRadius: "0.75rem", border: "1px solid #334155", padding: "3rem", maxWidth: "700px", margin: "2rem auto" }}>
        <div style={{ textAlign: "center", marginBottom: "2rem" }}>
          <div style={{ fontSize: "2.5rem", marginBottom: "1rem" }}>🔥</div>
          <h2 style={{ fontSize: "1.5rem", fontWeight: "700", marginBottom: "0.5rem" }}>Token Flame Graph</h2>
          <p style={{ color: "#94a3b8", marginBottom: "1.5rem", lineHeight: "1.6" }}>
            A profiler for AI agents. Every LLM call, tool call, and context window your agent touches gets recorded as a span. We render these as flame graphs so you can see exactly where tokens and money burn.
          </p>
        </div>

        <!-- Mini Flame Graph Animation -->
        <div style={{ background: "#0f172a", padding: "1.5rem", borderRadius: "0.5rem", marginBottom: "2rem", border: "1px solid #334155", display: "flex", alignItems: "flex-end", justifyContent: "center", gap: "0.5rem", height: "150px" }}>
          <div style={{ width: "100%", height: "100%", display: "flex", alignItems: "flex-end", justifyContent: "space-around", gap: "0.5rem" }}>
            <div style={{ background: "#7c3aed", width: "8%", height: "40%", borderRadius: "0.25rem", animation: "flamePulse 2s ease-in-out infinite", animationDelay: "0s" }}></div>
            <div style={{ background: "#f59e0b", width: "8%", height: "65%", borderRadius: "0.25rem", animation: "flamePulse 2s ease-in-out infinite", animationDelay: "0.1s" }}></div>
            <div style={{ background: "#7c3aed", width: "8%", height: "50%", borderRadius: "0.25rem", animation: "flamePulse 2s ease-in-out infinite", animationDelay: "0.2s" }}></div>
            <div style={{ background: "#f59e0b", width: "8%", height: "75%", borderRadius: "0.25rem", animation: "flamePulse 2s ease-in-out infinite", animationDelay: "0.3s" }}></div>
            <div style={{ background: "#7c3aed", width: "8%", height: "55%", borderRadius: "0.25rem", animation: "flamePulse 2s ease-in-out infinite", animationDelay: "0.4s" }}></div>
            <div style={{ background: "#f59e0b", width: "8%", height: "70%", borderRadius: "0.25rem", animation: "flamePulse 2s ease-in-out infinite", animationDelay: "0.5s" }}></div>
            <div style={{ background: "#ef4444", width: "8%", height: "85%", borderRadius: "0.25rem", animation: "flamePulse 2s ease-in-out infinite", animationDelay: "0.6s" }}></div>
            <div style={{ background: "#7c3aed", width: "8%", height: "45%", borderRadius: "0.25rem", animation: "flamePulse 2s ease-in-out infinite", animationDelay: "0.7s" }}></div>
            <div style={{ background: "#f59e0b", width: "8%", height: "60%", borderRadius: "0.25rem", animation: "flamePulse 2s ease-in-out infinite", animationDelay: "0.8s" }}></div>
            <div style={{ background: "#7c3aed", width: "8%", height: "50%", borderRadius: "0.25rem", animation: "flamePulse 2s ease-in-out infinite", animationDelay: "0.9s" }}></div>
          </div>
        </div>

        <div style={{ textAlign: "center", marginBottom: "2rem", color: "#cbd5e1", fontSize: "0.9rem" }}>
          <span style={{ display: "inline-flex", alignItems: "center", gap: "0.4rem", marginRight: "1rem" }}>
            <span style={{ width: "0.75rem", height: "0.75rem", background: "#7c3aed", borderRadius: "0.125rem", display: "inline-block" }}></span>
            LLM call
          </span>
          <span style={{ display: "inline-flex", alignItems: "center", gap: "0.4rem", marginRight: "1rem" }}>
            <span style={{ width: "0.75rem", height: "0.75rem", background: "#f59e0b", borderRadius: "0.125rem", display: "inline-block" }}></span>
            Tool call
          </span>
          <span style={{ display: "inline-flex", alignItems: "center", gap: "0.4rem" }}>
            <span style={{ width: "0.75rem", height: "0.75rem", background: "#ef4444", borderRadius: "0.125rem", display: "inline-block" }}></span>
            Loop detected
          </span>
        </div>

        <div style={{ background: "#0f172a", padding: "2rem", borderRadius: "0.5rem", border: "1px solid #334155", marginBottom: "2rem", textAlign: "left" }}>
          <h3 style={{ fontSize: "1rem", fontWeight: "700", marginBottom: "1.5rem", textAlign: "center" }}>Get started in 3 steps</h3>
          <div style={{ display: "flex", flexDirection: "column", gap: "1.5rem" }}>
            <div>
              <div style={{ fontSize: "0.875rem", color: "#f97316", fontWeight: "600", marginBottom: "0.5rem" }}>1 Install SDK</div>
              <code style={{ background: "#1a2836", padding: "0.5rem 0.75rem", borderRadius: "0.25rem", display: "block", fontSize: "0.85rem", color: "#e2e8f0", fontFamily: "JetBrains Mono, monospace", overflow: "auto" }}>npm install @flamegraph/sdk</code>
            </div>
            <div>
              <div style={{ fontSize: "0.875rem", color: "#f97316", fontWeight: "600", marginBottom: "0.5rem" }}>2 Instrument your agent</div>
              <code style={{ background: "#1a2836", padding: "0.75rem", borderRadius: "0.25rem", display: "block", fontSize: "0.85rem", color: "#e2e8f0", fontFamily: "JetBrains Mono, monospace", overflow: "auto" }}>
{`import { LocalCollector } from "flamegraph-sdk";
instrumentAgent(agent, {
  collector: new LocalCollector({
    serverUrl: "https://api.example.com",
    apiKey: "sk_your_key_here"
  })
});`}
              </code>
            </div>
            <div>
              <div style={{ fontSize: "0.875rem", color: "#f97316", fontWeight: "600", marginBottom: "0.5rem" }}>3 Run your agent</div>
              <p style={{ color: "#cbd5e1", fontSize: "0.875rem" }}>Sessions appear here automatically when your agent runs with instrumentation.</p>
            </div>
          </div>
        </div>

        <div style={{ textAlign: "center" }}>
          <a href="/app/settings" style={{ display: "inline-block", padding: "0.75rem 1.5rem", background: "#f97316", color: "white", textDecoration: "none", borderRadius: "0.375rem", fontWeight: "600", transition: "background 0.2s" }} onmouseover="this.style.background='#ea580c'" onmouseout="this.style.background='#f97316'">
            → Go to Settings to get your API key
          </a>
        </div>
      </div>
    ) : (
      <div style={{ overflowX: "auto" }}>
        <table style={{ width: "100%", fontSize: "0.875rem" }}>
          <thead>
            <tr style={{ borderBottom: "1px solid #334155", background: "#0f172a" }}>
              <th style={{ padding: "1rem", textAlign: "left", color: "#94a3b8", fontWeight: "600" }}>ID</th>
              <th style={{ padding: "1rem", textAlign: "left", color: "#94a3b8", fontWeight: "600" }}>Feature</th>
              <th style={{ padding: "1rem", textAlign: "left", color: "#94a3b8", fontWeight: "600" }}>Duration</th>
              <th style={{ padding: "1rem", textAlign: "left", color: "#94a3b8", fontWeight: "600" }}>Cost</th>
              <th style={{ padding: "1rem", textAlign: "left", color: "#94a3b8", fontWeight: "600" }}>Tokens</th>
              <th style={{ padding: "1rem", textAlign: "left", color: "#94a3b8", fontWeight: "600" }}>Status</th>
            </tr>
          </thead>
          <tbody>
            {sessions.map((session: any) => {
              const durationSec = Math.round((session.ended_at - session.started_at) / 1000);
              return (
                <tr
                  style={{ borderBottom: "1px solid #334155", transition: "background 0.2s" }}
                  onmouseover="this.style.background='rgba(255,255,255,0.03)'"
                  onmouseout="this.style.background='transparent'"
                >
                  <td style={{ padding: "1rem" }}>
                    <a href={`/app/sessions/${session.id}`} style={{ color: "#6366f1", textDecoration: "none" }}>
                      {session.id.slice(0, 12)}...
                    </a>
                  </td>
                  <td style={{ padding: "1rem", color: "#a1a1aa" }}>{session.feature || "—"}</td>
                  <td style={{ padding: "1rem", color: "#a1a1aa" }}>{durationSec}s</td>
                  <td style={{ padding: "1rem", fontWeight: "600" }}>${session.total_cost_usd.toFixed(4)}</td>
                  <td style={{ padding: "1rem", color: "#a1a1aa" }}>{(session.total_tokens || 0).toLocaleString()}</td>
                  <td style={{ padding: "1rem" }}>
                    {session.loop_detected ? (
                      <span style={{ background: "#7c2d12", color: "#fed7aa", padding: "0.25rem 0.75rem", borderRadius: "0.25rem", fontSize: "0.8rem" }}>
                        LOOP
                      </span>
                    ) : (
                      <span style={{ color: "#22c55e" }}>OK</span>
                    )}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    )}
  </div>
</Dashboard>
