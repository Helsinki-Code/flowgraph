---
export const prerender = false;

import Dashboard from "../../../layouts/Dashboard.astro";
import { API_URL } from "../../../lib/api";
import { fetchJsonWithTimeout } from "../../../lib/server-fetch";

let userId, token;
try {
  if (!Astro.locals?.auth) return Astro.redirect("/sign-in");
  const auth = Astro.locals.auth();
  userId = auth?.userId;
  token = auth?.getToken ? await auth.getToken() : null;
  if (!userId) return Astro.redirect("/sign-in");
} catch (e) {
  console.error("Auth error in /app/sessions/diff:", e);
  return Astro.redirect("/sign-in");
}

const baseSessionId = Astro.url.searchParams.get("base") || "";
const targetSessionId = Astro.url.searchParams.get("target") || "";

let sessions: any[] = [];
let diff: any = null;
let error: string | null = null;

if (token) {
  try {
    const sessionsData = await fetchJsonWithTimeout<{ sessions: any[] }>(
      `${API_URL}/v1/sessions?limit=100`,
      { headers: { Authorization: `Bearer ${token}` } },
    );
    sessions = sessionsData.sessions || [];

    if (baseSessionId && targetSessionId) {
      const diffData = await fetchJsonWithTimeout<{ diff: any }>(
        `${API_URL}/v1/sessions/diff?base_session_id=${encodeURIComponent(baseSessionId)}&target_session_id=${encodeURIComponent(targetSessionId)}`,
        {
          headers: { Authorization: `Bearer ${token}` },
          timeoutMs: 8000,
          retries: 1,
        },
      );
      diff = diffData.diff;
    }
  } catch (e: any) {
    error = `Failed to load comparison data: ${e.message}`;
  }
}
---

<Dashboard title="Session Diff" description="Compare two runs for cost, token, and reliability regressions.">
  <style>
    .panel {
      background: var(--panel-bg);
      border: 1px solid var(--panel-border);
      border-radius: 0.95rem;
      padding: 1.15rem;
      margin-bottom: 0.9rem;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 0.7rem;
      align-items: end;
    }

    .label {
      margin-bottom: 0.4rem;
      color: var(--text-dim);
      font-size: 0.8rem;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      font-weight: 700;
    }

    .control,
    .btn {
      width: 100%;
      border-radius: 0.55rem;
      border: 1px solid var(--line-strong);
      background: var(--surface-1);
      color: var(--text-main);
      padding: 0.6rem 0.72rem;
      font-size: 0.88rem;
    }

    .btn {
      cursor: pointer;
      background: var(--accent);
      border-color: transparent;
      color: #fff;
      font-weight: 700;
    }

    .btn:hover {
      background: var(--accent-strong);
    }

    .metric {
      border: 1px solid var(--line-strong);
      border-radius: 0.7rem;
      padding: 0.8rem;
      background: var(--surface-3);
    }

    .metric-key {
      color: var(--text-dim);
      font-size: 0.74rem;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      font-weight: 700;
    }

    .metric-value {
      color: var(--text-main);
      font-family: "JetBrains Mono", monospace;
      font-size: 1.06rem;
      margin-top: 0.35rem;
      font-weight: 700;
    }

    .delta-up {
      color: var(--danger-text);
      font-weight: 700;
      margin-top: 0.3rem;
      font-size: 0.82rem;
    }

    .delta-down {
      color: var(--success-text);
      font-weight: 700;
      margin-top: 0.3rem;
      font-size: 0.82rem;
    }

    .delta-flat {
      color: var(--text-subtle);
      font-weight: 700;
      margin-top: 0.3rem;
      font-size: 0.82rem;
    }
  </style>

  <div class="panel">
    <form class="grid" method="get">
      <label>
        <div class="label">Base session</div>
        <select class="control" name="base" required>
          <option value="">Select session</option>
          {sessions.map((session) => (
            <option value={session.id} selected={baseSessionId === session.id}>
              {session.id.slice(0, 12)} | ${session.total_cost_usd.toFixed(4)} | {(session.total_tokens || 0).toLocaleString()} tokens
            </option>
          ))}
        </select>
      </label>
      <label>
        <div class="label">Target session</div>
        <select class="control" name="target" required>
          <option value="">Select session</option>
          {sessions.map((session) => (
            <option value={session.id} selected={targetSessionId === session.id}>
              {session.id.slice(0, 12)} | ${session.total_cost_usd.toFixed(4)} | {(session.total_tokens || 0).toLocaleString()} tokens
            </option>
          ))}
        </select>
      </label>
      <button class="btn" type="submit">Compare Runs</button>
    </form>
  </div>

  {error && (
    <div class="panel" style={{ borderColor: "var(--danger-border)", background: "var(--danger-bg)", color: "var(--danger-text)" }}>
      {error}
    </div>
  )}

  {diff && (
    <>
      <div class="panel">
        <h3 style={{ marginBottom: "0.75rem" }}>Core Metrics</h3>
        <div class="grid">
          {Object.entries(diff.metrics).map(([key, value]: [string, any]) => (
            <div class="metric">
              <div class="metric-key">{key}</div>
              <div class="metric-value">
                {typeof value.target === "number"
                  ? value.target.toLocaleString(undefined, { maximumFractionDigits: 4 })
                  : value.target}
              </div>
              <div class={value.delta > 0 ? "delta-up" : value.delta < 0 ? "delta-down" : "delta-flat"}>
                Delta {value.delta.toLocaleString(undefined, { maximumFractionDigits: 4 })} ({value.deltaPct.toFixed(1)}%)
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="panel">
        <h3 style={{ marginBottom: "0.75rem" }}>Top Regressions</h3>
        {diff.regressions.length === 0 ? (
          <p style={{ color: "var(--text-dim)", margin: 0 }}>
            No positive-cost or positive-token regressions detected.
          </p>
        ) : (
          <div style={{ display: "grid", gap: "0.5rem" }}>
            {diff.regressions.map((regression: any) => (
              <div class="metric">
                <div style={{ fontWeight: "700", color: "var(--text-main)" }}>{regression.key}</div>
                <div style={{ color: "var(--text-subtle)", fontSize: "0.84rem", marginTop: "0.34rem" }}>
                  Cost +${regression.deltaCostUsd.toFixed(4)} | Tokens +{regression.deltaTokens.toLocaleString()}
                </div>
              </div>
            ))}
          </div>
        )}
      </div>
    </>
  )}
</Dashboard>
