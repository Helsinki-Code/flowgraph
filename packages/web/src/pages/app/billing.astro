---
export const prerender = false;

import Dashboard from "../../layouts/Dashboard.astro";
import { API_URL } from "../../lib/api";
import { fetchJsonWithTimeout } from "../../lib/server-fetch";

let userId, orgId, token;
try {
  if (!Astro.locals?.auth) {
    return Astro.redirect("/sign-in");
  }

  const auth = Astro.locals.auth();
  userId = auth?.userId;
  orgId = auth?.orgId;
  token = auth?.getToken ? await auth.getToken() : null;

  if (!userId) {
    return Astro.redirect("/sign-in");
  }
} catch (e) {
  console.error("Auth error in /app/billing:", e);
  return Astro.redirect("/sign-in");
}

const workspaceId = orgId || userId;
let workspace = { plan: "free", sessions_this_month: 0 };
let error = null;

if (workspaceId && token) {
  try {
    const data = await fetchJsonWithTimeout<{ workspace: any }>(`${API_URL}/v1/workspace`, {
      headers: { Authorization: `Bearer ${token}` },
      timeoutMs: 8000,
      retries: 1,
    });
    workspace = data.workspace || workspace;
  } catch (e: any) {
    error = `Failed to load workspace: ${e.message}`;
  }
} else {
  error = "Missing authentication data";
}

const planLimits = {
  free: { sessions: -1, cost: "$0" },
  pro: { sessions: 10000, cost: "$49" },
  business: { sessions: -1, cost: "$299" },
};

const limits = planLimits[workspace.plan as keyof typeof planLimits] || planLimits.free;
---

<Dashboard title="Billing" description="Manage subscription and usage">
  {error && <div style={{ padding: "1rem", background: "var(--danger-bg)", color: "var(--danger-text)", borderRadius: "0.375rem", marginBottom: "1.5rem" }}>{error}</div>}

  <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: "2rem" }}>
    <div style={{ background: "var(--surface-2)", padding: "2rem", borderRadius: "0.5rem", border: "1px solid var(--line-strong)" }}>
      <h3 style={{ fontSize: "1.25rem", fontWeight: "600", marginBottom: "1rem" }}>Current Plan</h3>
      <div style={{ fontSize: "2rem", fontWeight: "700", marginBottom: "0.5rem", textTransform: "capitalize" }}>
        {workspace.plan}
      </div>
      <div style={{ color: "var(--text-dim)", marginBottom: "2rem" }}>
        {limits.cost}/month
      </div>
      {workspace.plan === "free" && (
        <a href="/pricing" style={{ display: "inline-block", padding: "0.75rem 1.5rem", background: "var(--accent)", color: "white", textDecoration: "none", borderRadius: "0.375rem", fontWeight: "600" }}>
          Upgrade to Pro
        </a>
      )}
    </div>

    <div style={{ background: "var(--surface-2)", padding: "2rem", borderRadius: "0.5rem", border: "1px solid var(--line-strong)" }}>
      <h3 style={{ fontSize: "1.25rem", fontWeight: "600", marginBottom: "1rem" }}>Usage</h3>
      <div style={{ marginBottom: "1rem" }}>
        <div style={{ display: "flex", justifyContent: "space-between", marginBottom: "0.5rem" }}>
          <span>Sessions this month</span>
          <span style={{ fontWeight: "600" }}>
            {workspace.sessions_this_month} {limits.sessions > 0 ? ` / ${limits.sessions}` : ""}
          </span>
        </div>
        {limits.sessions > 0 && (
          <div style={{ width: "100%", height: "8px", background: "var(--surface-1)", borderRadius: "9999px", overflow: "hidden" }}>
            <div
              style={{
                height: "100%",
                background: "var(--accent)",
                width: `${Math.min((workspace.sessions_this_month / limits.sessions) * 100, 100)}%`,
              }}
            />
          </div>
        )}
      </div>
    </div>
  </div>

  <div style={{ marginTop: "2rem", padding: "1.5rem", background: "var(--surface-2)", borderRadius: "0.5rem", border: "1px solid var(--line-strong)" }}>
    <h3 style={{ marginBottom: "1rem" }}>Invoice History</h3>
    <p style={{ color: "var(--text-dim)" }}>No invoices yet.</p>
  </div>
</Dashboard>

