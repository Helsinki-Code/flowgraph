---
export const prerender = false;

import Dashboard from "../../layouts/Dashboard.astro";
import { API_URL } from "../../lib/api";
import { fetchJsonWithTimeout } from "../../lib/server-fetch";

let userId, token;
try {
  if (!Astro.locals?.auth) return Astro.redirect("/sign-in");
  const auth = Astro.locals.auth();
  userId = auth?.userId;
  token = auth?.getToken ? await auth.getToken() : null;
  if (!userId) return Astro.redirect("/sign-in");
} catch (e) {
  console.error("Auth error in /app/budgets:", e);
  return Astro.redirect("/sign-in");
}

let budgets: any[] = [];
let error: string | null = null;

if (token) {
  try {
    const data = await fetchJsonWithTimeout<{ budgets: any[] }>(`${API_URL}/v1/budgets`, {
      headers: { Authorization: `Bearer ${token}` },
      timeoutMs: 8000,
      retries: 1,
    });
    budgets = data.budgets || [];
  } catch (e: any) {
    error = `Failed to load budgets: ${e.message}`;
  }
}
---

<Dashboard title="Budgets" description="Set hard limits for session, agent, or call spending.">
  <style>
    .error-banner {
      padding: 1rem;
      border-radius: 0.72rem;
      background: var(--danger-bg);
      color: var(--danger-text);
      margin-bottom: 1rem;
      border: 1px solid var(--danger-border);
      font-size: 0.88rem;
    }

    .panel {
      background: var(--panel-bg);
      border: 1px solid var(--panel-border);
      border-radius: 0.95rem;
      padding: 1rem;
      margin-bottom: 0.9rem;
    }

    .panel h2 {
      margin: 0 0 0.82rem;
      font-size: 1rem;
      font-family: "Bricolage Grotesque", sans-serif;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
      gap: 0.65rem;
    }

    .control {
      width: 100%;
      background: var(--surface-1);
      border: 1px solid var(--line-strong);
      border-radius: 0.5rem;
      color: var(--text-main);
      padding: 0.64rem 0.74rem;
      font-size: 0.88rem;
    }

    .btn {
      background: var(--accent);
      color: #fff;
      border: none;
      border-radius: 0.54rem;
      padding: 0.7rem 1rem;
      font-weight: 700;
      cursor: pointer;
    }

    .btn:hover {
      background: var(--accent-strong);
    }

    .btn.secondary {
      background: var(--danger-bg);
      color: var(--danger-text);
      border: 1px solid var(--danger-border);
      font-weight: 600;
    }

    .btn.secondary:hover {
      filter: brightness(1.04);
    }

    .list-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.8rem;
      border: 1px solid var(--line-strong);
      background: var(--surface-3);
      border-radius: 0.78rem;
      padding: 0.85rem 0.95rem;
      margin-bottom: 0.58rem;
    }

    .meta {
      font-size: 0.82rem;
      color: var(--text-dim);
      margin-top: 0.2rem;
    }
  </style>

  {error && <div class="error-banner">{error}</div>}

  <div class="panel">
    <h2>Create Budget Policy</h2>
    <form id="budget-form" class="grid">
      <input class="control" type="text" name="name" placeholder="Policy name (optional)" />
      <select class="control" name="scope">
        <option value="session">Session</option>
        <option value="agent">Agent</option>
        <option value="call">Call</option>
      </select>
      <select class="control" name="metric">
        <option value="cost_usd">Cost (USD)</option>
        <option value="tokens">Tokens</option>
      </select>
      <input class="control" type="text" name="target" placeholder="Target (session id, agent id, model) optional" />
      <input class="control" type="number" step="0.0001" min="0.0001" name="limitValue" placeholder="Limit value" required />
      <select class="control" name="action">
        <option value="warn">Warn</option>
        <option value="block">Block</option>
      </select>
      <button class="btn" type="submit">Save Policy</button>
    </form>
  </div>

  <div class="panel">
    <h2>Active Policies</h2>
    {budgets.length === 0 ? (
      <p style={{ color: "var(--text-dim)", margin: 0 }}>
        No budget policies yet. Create one to enforce session, agent, or per-call limits.
      </p>
    ) : (
      budgets.map((budget) => (
        <div class="list-item">
          <div>
            <div style={{ fontWeight: "700", color: "var(--text-main)" }}>{budget.name}</div>
            <div class="meta">
              {budget.scope} | {budget.metric} | limit {budget.limit_value}
              {budget.target ? ` | target=${budget.target}` : " | target=all"}
              {budget.action === "block" ? " | BLOCK" : " | WARN"}
            </div>
          </div>
          <button type="button" class="btn secondary delete-budget-btn" data-budget-id={budget.id}>
            Delete
          </button>
        </div>
      ))
    )}
  </div>

  <script define:vars={{ API_URL, token }}>
    const budgetForm = document.getElementById("budget-form");
    budgetForm?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const formData = new FormData(budgetForm);
      const payload = Object.fromEntries(formData.entries());
      payload.limitValue = Number(payload.limitValue);

      try {
        const response = await fetch(`${API_URL}/v1/budgets`, {
          method: "POST",
          headers: {
            Authorization: `Bearer ${token}`,
            "Content-Type": "application/json",
          },
          body: JSON.stringify(payload),
        });
        if (!response.ok) {
          const text = await response.text();
          alert(`Failed to save budget: ${text}`);
          return;
        }
        location.reload();
      } catch {
        alert("Failed to save budget");
      }
    });

    document.querySelectorAll(".delete-budget-btn").forEach((button) => {
      button.addEventListener("click", async () => {
        const budgetId = button.getAttribute("data-budget-id");
        if (!budgetId) return;
        if (!confirm("Delete this budget policy?")) return;
        try {
          const response = await fetch(`${API_URL}/v1/budgets/${budgetId}`, {
            method: "DELETE",
            headers: { Authorization: `Bearer ${token}` },
          });
          if (!response.ok) {
            const text = await response.text();
            alert(`Delete failed: ${text}`);
            return;
          }
          location.reload();
        } catch {
          alert("Delete failed");
        }
      });
    });
  </script>
</Dashboard>
