---
import { SignIn } from "@clerk/astro/components";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In — Flame Graph</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      body {
        background: linear-gradient(135deg, #09090b 0%, #1a1a2e 100%);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue",
          Arial, sans-serif;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
      }
      main {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2rem;
      }
      h1 {
        color: #fafafa;
        font-size: 2rem;
        font-weight: 700;
        text-align: center;
      }
      :global(.cl-root) {
        scale: 0.9;
      }
    </style>
  </head>
  <body>
    <main>
      <h1>🔥 Flame Graph</h1>
      <SignIn redirectUrl="/app" />
    </main>
  </body>
</html>
