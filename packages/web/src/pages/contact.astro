---
import Public from "../layouts/Public.astro";
---

<Public title="Contact" description="Contact Token Flame Graph support and sales.">
  <div class="container" style="max-width: 900px; padding: 4rem 1rem;">
    <h1 style="margin-bottom: 1rem;">Contact</h1>
    <p style="color: var(--text-secondary); margin-bottom: 2rem;">
      We usually respond within one business day.
    </p>
    <h2>Support</h2>
    <p>
      <a href="mailto:support@eddieai.online">support@eddieai.online</a>
    </p>
    <h2 style="margin-top: 2rem;">Security</h2>
    <p>
      Report vulnerabilities or exposed credentials: <a href="mailto:security@eddieai.online">security@eddieai.online</a>
    </p>
    <h2 style="margin-top: 2rem;">Sales</h2>
    <p>
      <a href="mailto:sales@eddieai.online">sales@eddieai.online</a>
    </p>
  </div>
</Public>
