---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description || "AI agent session profiler"} />
    <title>{title} - Token Flame Graph</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@600;700;800&family=Manrope:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
    <script is:inline>
      (() => {
        const key = "tfg-public-theme";
        const stored = localStorage.getItem(key);
        const prefersDark = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
        const theme = stored === "light" || stored === "dark" ? stored : prefersDark ? "dark" : "light";
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
    <style>
      html[data-theme="dark"] {
        color-scheme: dark;
        --pub-bg: #050812;
        --pub-bg-2: #0b1020;
        --pub-surface: rgba(12, 19, 34, 0.86);
        --pub-surface-2: #141f37;
        --pub-border: rgba(148, 163, 184, 0.23);
        --pub-text: #eaf1ff;
        --pub-text-subtle: #b3c2de;
        --pub-text-dim: #8ea2c9;
        --pub-accent: #f97316;
        --pub-accent-strong: #ea580c;
        --bg-base: #050812;
        --bg-card: rgba(12, 19, 34, 0.86);
        --bg-surface: #141f37;
        --text-primary: #eaf1ff;
        --text-secondary: #b3c2de;
        --text-muted: #8ea2c9;
        --border: rgba(148, 163, 184, 0.23);
        --accent: #f97316;
        --accent-hover: #ea580c;
      }

      html[data-theme="light"] {
        color-scheme: light;
        --pub-bg: #f7f9ff;
        --pub-bg-2: #edf3ff;
        --pub-surface: rgba(255, 255, 255, 0.9);
        --pub-surface-2: #ebf2ff;
        --pub-border: rgba(15, 23, 42, 0.14);
        --pub-text: #0f172a;
        --pub-text-subtle: #334155;
        --pub-text-dim: #5d718f;
        --pub-accent: #ea580c;
        --pub-accent-strong: #c2410c;
        --bg-base: #f7f9ff;
        --bg-card: rgba(255, 255, 255, 0.9);
        --bg-surface: #ebf2ff;
        --text-primary: #0f172a;
        --text-secondary: #334155;
        --text-muted: #5d718f;
        --border: rgba(15, 23, 42, 0.14);
        --accent: #ea580c;
        --accent-hover: #c2410c;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: "Manrope", sans-serif;
        color: var(--pub-text);
        background:
          radial-gradient(circle at 14% 11%, rgba(249, 115, 22, 0.18), transparent 36%),
          radial-gradient(circle at 86% 19%, rgba(56, 189, 248, 0.18), transparent 35%),
          linear-gradient(180deg, var(--pub-bg), var(--pub-bg-2));
        min-height: 100vh;
      }

      .grid-overlay {
        position: fixed;
        inset: 0;
        pointer-events: none;
        background-image: linear-gradient(rgba(148, 163, 184, 0.09) 1px, transparent 1px), linear-gradient(90deg, rgba(148, 163, 184, 0.09) 1px, transparent 1px);
        background-size: 32px 32px;
        mask-image: radial-gradient(circle at center, black, transparent 82%);
        opacity: 0.26;
        z-index: -1;
      }

      .top-nav-wrap {
        position: sticky;
        top: 0;
        z-index: 100;
        padding: 0.9rem 1rem;
        backdrop-filter: blur(18px);
      }

      .top-nav {
        max-width: 1180px;
        margin: 0 auto;
        border: 1px solid var(--pub-border);
        border-radius: 1rem;
        background: var(--pub-surface);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.72rem 0.85rem;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.7rem;
        text-decoration: none;
        color: var(--pub-text);
      }

      .brand-icon {
        width: 1.9rem;
        height: 1.9rem;
        border-radius: 0.6rem;
        display: grid;
        place-items: center;
        background: linear-gradient(140deg, var(--pub-accent), #22d3ee);
        color: #fff;
      }

      .brand-text strong {
        display: block;
        font-family: "Bricolage Grotesque", sans-serif;
        font-size: 0.95rem;
        letter-spacing: -0.02em;
      }

      .brand-text span {
        color: var(--pub-text-dim);
        font-size: 0.72rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        font-weight: 700;
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 0.35rem;
      }

      .nav-link {
        text-decoration: none;
        color: var(--pub-text-subtle);
        font-weight: 700;
        font-size: 0.82rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        border-radius: 999px;
        padding: 0.43rem 0.72rem;
        border: 1px solid transparent;
      }

      .nav-link:hover {
        border-color: var(--pub-border);
        background: var(--pub-surface-2);
      }

      .nav-actions {
        display: flex;
        align-items: center;
        gap: 0.45rem;
      }

      .theme-toggle {
        border: 1px solid var(--pub-border);
        background: var(--pub-surface-2);
        color: var(--pub-text);
        border-radius: 999px;
        padding: 0.34rem 0.52rem;
        cursor: pointer;
        font-size: 0.78rem;
        font-weight: 700;
      }

      .theme-toggle:hover {
        border-color: var(--pub-accent);
        color: var(--pub-accent);
      }

      .cta-link {
        text-decoration: none;
        border-radius: 999px;
        padding: 0.45rem 0.82rem;
        font-size: 0.81rem;
        font-weight: 700;
        border: 1px solid transparent;
      }

      .cta-link.ghost {
        background: var(--pub-surface-2);
        border-color: var(--pub-border);
        color: var(--pub-text);
      }

      .cta-link.ghost:hover {
        border-color: var(--pub-accent);
        color: var(--pub-accent);
      }

      .cta-link.primary {
        background: var(--pub-accent);
        color: #fff;
      }

      .cta-link.primary:hover {
        background: var(--pub-accent-strong);
      }

      main {
        max-width: 1180px;
        margin: 0 auto;
        padding: 1rem;
      }

      .footer {
        margin-top: 3rem;
        border-top: 1px solid var(--pub-border);
        padding: 1.4rem 1rem 2rem;
      }

      .footer-inner {
        max-width: 1180px;
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        color: var(--pub-text-dim);
        font-size: 0.82rem;
      }

      .footer-links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.7rem;
      }

      .footer-links a {
        color: var(--pub-text-dim);
        text-decoration: none;
      }

      .footer-links a:hover {
        color: var(--pub-accent);
      }

      @media (max-width: 980px) {
        .nav-links {
          display: none;
        }
      }

      @media (max-width: 620px) {
        .top-nav {
          padding: 0.65rem;
        }

        .brand-text span {
          display: none;
        }

        .cta-link.ghost {
          display: none;
        }

        .footer-inner {
          flex-direction: column;
          align-items: flex-start;
        }
      }
    </style>
  </head>
  <body>
    <div class="grid-overlay"></div>

    <div class="top-nav-wrap">
      <nav class="top-nav">
        <a class="brand" href="/">
          <span class="brand-icon">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 18h3l1-8 4 10 2-6 2 4h4"></path>
            </svg>
          </span>
          <span class="brand-text">
            <strong>Token Flame Graph</strong>
            <span>AI telemetry</span>
          </span>
        </a>

        <div class="nav-links">
          <a class="nav-link" href="/">Home</a>
          <a class="nav-link" href="/pricing">Pricing</a>
          <a class="nav-link" href="/docs">Docs</a>
          <a class="nav-link" href="/status">Status</a>
        </div>

        <div class="nav-actions">
          <button id="theme-toggle" class="theme-toggle" type="button">Theme</button>
          <a href="/sign-in" class="cta-link ghost">Sign In</a>
          <a href="/sign-up" class="cta-link primary">Start Free</a>
        </div>
      </nav>
    </div>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="footer-inner">
        <span>2026 Token Flame Graph. Built for production AI teams.</span>
        <div class="footer-links">
          <a href="/privacy">Privacy</a>
          <a href="/terms">Terms</a>
          <a href="/contact">Contact</a>
          <a href="https://github.com/Helsinki-Code/flowgraph" target="_blank" rel="noreferrer">GitHub</a>
        </div>
      </div>
    </footer>

    <script>
      const key = "tfg-public-theme";
      const toggle = document.getElementById("theme-toggle");
      const html = document.documentElement;

      function applyTheme(theme) {
        html.setAttribute("data-theme", theme);
        localStorage.setItem(key, theme);
      }

      toggle?.addEventListener("click", () => {
        const current = html.getAttribute("data-theme") === "light" ? "light" : "dark";
        applyTheme(current === "dark" ? "light" : "dark");
      });
    </script>
  </body>
</html>
