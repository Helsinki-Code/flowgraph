---
import { UserButton } from "@clerk/astro/components";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const isSessionsRoute = Astro.url.pathname.startsWith("/app") && !Astro.url.pathname.startsWith("/app/cost")
  && !Astro.url.pathname.startsWith("/app/alerts")
  && !Astro.url.pathname.startsWith("/app/billing")
  && !Astro.url.pathname.startsWith("/app/settings")
  && !Astro.url.pathname.startsWith("/app/budgets");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} - Token Flame Graph</title>
    <meta name="description" content={description || "AI agent session profiler"} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@500;700;800&family=Manrope:wght@500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
    <script is:inline>
      (() => {
        const themeKey = "tfg-theme";
        const sidebarKey = "tfg-sidebar-collapsed";
        const savedTheme = localStorage.getItem(themeKey);
        const prefersDark = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
        const theme = savedTheme === "light" || savedTheme === "dark" ? savedTheme : prefersDark ? "dark" : "light";
        document.documentElement.setAttribute("data-theme", theme);
        if (localStorage.getItem(sidebarKey) === "true") {
          document.documentElement.classList.add("sidebar-collapsed");
        }
      })();
    </script>
    <style>
      :root {
        --sidebar-width: 18rem;
        --sidebar-collapsed-width: 5.25rem;
        --radius-lg: 1rem;
        --radius-md: 0.75rem;
        --radius-sm: 0.5rem;
        --shadow-soft: 0 24px 60px rgba(6, 12, 26, 0.16);
        --transition-main: 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
      }

      html[data-theme="dark"] {
        color-scheme: dark;
        --bg-canvas: #06080f;
        --bg-canvas-2: #0b0f1a;
        --bg-orb-a: rgba(251, 113, 34, 0.2);
        --bg-orb-b: rgba(15, 172, 213, 0.22);
        --bg-orb-c: rgba(123, 97, 255, 0.2);
        --sidebar-bg: rgba(7, 11, 20, 0.86);
        --sidebar-border: rgba(148, 163, 184, 0.22);
        --panel-bg: rgba(16, 23, 39, 0.82);
        --panel-border: rgba(148, 163, 184, 0.2);
        --surface-1: #16243b;
        --surface-2: #1b2d45;
        --surface-3: #13253d;
        --line-strong: rgba(148, 163, 184, 0.3);
        --text-main: #ebf2ff;
        --text-subtle: #b8c4df;
        --text-dim: #8da2c8;
        --accent: #f97316;
        --accent-strong: #ea580c;
        --accent-soft: rgba(249, 115, 22, 0.18);
        --danger-bg: rgba(127, 29, 29, 0.78);
        --danger-text: #fecaca;
        --danger-border: #b91c1c;
        --success-text: #86efac;
      }

      html[data-theme="light"] {
        color-scheme: light;
        --bg-canvas: #f6f8ff;
        --bg-canvas-2: #edf2ff;
        --bg-orb-a: rgba(251, 113, 34, 0.2);
        --bg-orb-b: rgba(14, 165, 233, 0.17);
        --bg-orb-c: rgba(59, 130, 246, 0.15);
        --sidebar-bg: rgba(255, 255, 255, 0.9);
        --sidebar-border: rgba(15, 23, 42, 0.12);
        --panel-bg: rgba(255, 255, 255, 0.88);
        --panel-border: rgba(15, 23, 42, 0.14);
        --surface-1: #ecf3ff;
        --surface-2: #e3ecff;
        --surface-3: #f4f8ff;
        --line-strong: rgba(15, 23, 42, 0.16);
        --text-main: #0f172a;
        --text-subtle: #334155;
        --text-dim: #5b6f90;
        --accent: #ea580c;
        --accent-strong: #c2410c;
        --accent-soft: rgba(234, 88, 12, 0.14);
        --danger-bg: rgba(254, 226, 226, 0.95);
        --danger-text: #7f1d1d;
        --danger-border: rgba(185, 28, 28, 0.35);
        --success-text: #15803d;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100vh;
        font-family: "Manrope", "Segoe UI", sans-serif;
        color: var(--text-main);
        background:
          radial-gradient(circle at 7% 12%, var(--bg-orb-a), transparent 34%),
          radial-gradient(circle at 92% 16%, var(--bg-orb-b), transparent 38%),
          radial-gradient(circle at 74% 84%, var(--bg-orb-c), transparent 42%),
          linear-gradient(180deg, var(--bg-canvas), var(--bg-canvas-2));
        background-attachment: fixed;
      }

      body::after {
        content: "";
        position: fixed;
        inset: 0;
        pointer-events: none;
        background-image: linear-gradient(rgba(148, 163, 184, 0.08) 1px, transparent 1px), linear-gradient(90deg, rgba(148, 163, 184, 0.08) 1px, transparent 1px);
        background-size: 30px 30px;
        mask-image: radial-gradient(circle at center, black, transparent 82%);
        opacity: 0.28;
        z-index: -1;
      }

      .app-shell {
        display: grid;
        grid-template-columns: var(--sidebar-width) 1fr;
        min-height: 100vh;
        transition: grid-template-columns var(--transition-main);
      }

      html.sidebar-collapsed .app-shell {
        grid-template-columns: var(--sidebar-collapsed-width) 1fr;
      }

      .side-rail {
        position: sticky;
        top: 0;
        height: 100vh;
        padding: 1rem 0.9rem;
        backdrop-filter: blur(20px);
        background: var(--sidebar-bg);
        border-right: 1px solid var(--sidebar-border);
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }

      .brand {
        position: relative;
        border: 1px solid var(--panel-border);
        border-radius: var(--radius-lg);
        background: var(--panel-bg);
        padding: 1rem 0.9rem;
        display: flex;
        align-items: center;
        gap: 0.8rem;
      }

      .brand-mark {
        width: 2.1rem;
        height: 2.1rem;
        border-radius: 0.65rem;
        background: linear-gradient(140deg, var(--accent), #22d3ee);
        display: grid;
        place-items: center;
        color: #fff;
        box-shadow: 0 12px 28px rgba(15, 23, 42, 0.25);
        flex-shrink: 0;
      }

      .brand-copy {
        min-width: 0;
        transition: opacity var(--transition-main), transform var(--transition-main);
      }

      .brand-title {
        margin: 0;
        font-family: "Bricolage Grotesque", sans-serif;
        font-weight: 800;
        letter-spacing: -0.02em;
        font-size: 1.02rem;
      }

      .brand-subtitle {
        margin: 0.2rem 0 0;
        font-size: 0.72rem;
        color: var(--text-dim);
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }

      .sidebar-toggle {
        position: absolute;
        right: 0.6rem;
        top: 0.6rem;
        border: 1px solid var(--panel-border);
        background: var(--surface-1);
        color: var(--text-subtle);
        width: 1.9rem;
        height: 1.9rem;
        border-radius: 0.5rem;
        display: grid;
        place-items: center;
        cursor: pointer;
        transition: transform var(--transition-main), color var(--transition-main), border-color var(--transition-main);
      }

      .sidebar-toggle:hover {
        color: var(--accent);
        border-color: var(--accent);
      }

      .nav {
        border: 1px solid var(--panel-border);
        border-radius: var(--radius-lg);
        background: var(--panel-bg);
        padding: 0.55rem;
        display: flex;
        flex-direction: column;
        gap: 0.34rem;
      }

      .nav a {
        text-decoration: none;
      }

      .nav-item {
        display: grid;
        grid-template-columns: 1.6rem 1fr;
        align-items: center;
        gap: 0.7rem;
        border-radius: 0.68rem;
        padding: 0.65rem 0.7rem;
        color: var(--text-subtle);
        border: 1px solid transparent;
        transition: background var(--transition-main), border-color var(--transition-main), color var(--transition-main);
        font-weight: 700;
        font-size: 0.9rem;
      }

      .nav-item:hover {
        background: var(--surface-1);
        border-color: var(--panel-border);
      }

      .nav-item.active {
        color: var(--text-main);
        background: linear-gradient(130deg, var(--accent-soft), rgba(34, 211, 238, 0.12));
        border-color: rgba(249, 115, 22, 0.35);
      }

      .nav-icon {
        width: 1.1rem;
        height: 1.1rem;
      }

      .nav-label {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        transition: opacity var(--transition-main), transform var(--transition-main);
      }

      .side-footer {
        margin-top: auto;
        border: 1px solid var(--panel-border);
        border-radius: var(--radius-lg);
        background: var(--panel-bg);
        padding: 0.7rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.7rem;
      }

      .theme-toggle {
        border: 1px solid var(--panel-border);
        background: var(--surface-1);
        color: var(--text-main);
        border-radius: 999px;
        padding: 0.32rem 0.52rem;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        cursor: pointer;
        transition: transform var(--transition-main), border-color var(--transition-main);
      }

      .theme-toggle:hover {
        transform: translateY(-1px);
        border-color: var(--accent);
      }

      .theme-dot {
        width: 0.95rem;
        height: 0.95rem;
        border-radius: 50%;
        background: linear-gradient(140deg, #f97316, #22d3ee);
      }

      .theme-label {
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }

      .workspace {
        padding: 1.1rem 1.4rem 1.5rem;
      }

      .header {
        border: 1px solid var(--panel-border);
        border-radius: var(--radius-lg);
        padding: 1.2rem 1.25rem;
        background: var(--panel-bg);
        box-shadow: var(--shadow-soft);
        margin-bottom: 1rem;
      }

      .header-label {
        font-size: 0.72rem;
        font-weight: 700;
        color: var(--text-dim);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        margin-bottom: 0.2rem;
      }

      .header h1 {
        margin: 0;
        font-family: "Bricolage Grotesque", sans-serif;
        font-size: clamp(1.35rem, 2.7vw, 2.15rem);
        letter-spacing: -0.02em;
      }

      .header p {
        margin: 0.45rem 0 0;
        color: var(--text-subtle);
        max-width: 52ch;
      }

      .content {
        animation: contentIn 360ms ease-out;
      }

      @keyframes contentIn {
        from {
          opacity: 0;
          transform: translateY(8px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      html.sidebar-collapsed .brand-copy,
      html.sidebar-collapsed .nav-label,
      html.sidebar-collapsed .theme-label {
        opacity: 0;
        transform: translateX(-8px);
        width: 0;
        pointer-events: none;
      }

      html.sidebar-collapsed .side-footer {
        justify-content: center;
      }

      html.sidebar-collapsed .theme-toggle {
        padding-inline: 0.35rem;
      }

      html.sidebar-collapsed .brand {
        justify-content: center;
      }

      html.sidebar-collapsed .sidebar-toggle svg {
        transform: rotate(180deg);
      }

      @media (max-width: 1040px) {
        .app-shell,
        html.sidebar-collapsed .app-shell {
          grid-template-columns: 1fr;
        }

        .side-rail {
          position: static;
          height: auto;
        }

        .brand {
          padding-right: 2.8rem;
        }

        .nav {
          display: grid;
          grid-template-columns: repeat(3, minmax(0, 1fr));
          gap: 0.35rem;
        }

        .nav-item {
          grid-template-columns: 1fr;
          justify-items: center;
          text-align: center;
          font-size: 0.78rem;
          gap: 0.4rem;
          min-height: 4rem;
        }

        .nav-label,
        html.sidebar-collapsed .nav-label,
        html.sidebar-collapsed .theme-label,
        html.sidebar-collapsed .brand-copy {
          opacity: 1;
          width: auto;
          transform: none;
          pointer-events: auto;
        }

        .workspace {
          padding: 1rem;
        }
      }

      @media (max-width: 680px) {
        .nav {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .side-footer {
          justify-content: space-between;
        }

        .theme-label {
          display: none;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </head>
  <body>
    <div class="app-shell">
      <aside class="side-rail">
        <div class="brand">
          <button id="sidebar-toggle" class="sidebar-toggle" type="button" aria-label="Toggle sidebar">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M15 18l-6-6 6-6"></path>
            </svg>
          </button>
          <div class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 18h3l1-8 4 10 2-6 2 4h4"></path>
            </svg>
          </div>
          <div class="brand-copy">
            <p class="brand-title">Token Flame Graph</p>
            <p class="brand-subtitle">Control room</p>
          </div>
        </div>

        <nav class="nav">
          <a href="/app" class={`nav-item ${isSessionsRoute ? "active" : ""}`}>
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="8" height="8" rx="1"></rect>
              <rect x="13" y="3" width="8" height="5" rx="1"></rect>
              <rect x="13" y="10" width="8" height="11" rx="1"></rect>
              <rect x="3" y="13" width="8" height="8" rx="1"></rect>
            </svg>
            <span class="nav-label">Sessions</span>
          </a>
          <a href="/app/cost" class={`nav-item ${Astro.url.pathname === "/app/cost" ? "active" : ""}`}>
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 18h16"></path>
              <path d="M6 16V9"></path>
              <path d="M12 16V5"></path>
              <path d="M18 16v-4"></path>
            </svg>
            <span class="nav-label">Cost</span>
          </a>
          <a href="/app/alerts" class={`nav-item ${Astro.url.pathname === "/app/alerts" ? "active" : ""}`}>
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"></path>
              <path d="M13.7 21a2 2 0 0 1-3.4 0"></path>
            </svg>
            <span class="nav-label">Alerts</span>
          </a>
          <a href="/app/billing" class={`nav-item ${Astro.url.pathname === "/app/billing" ? "active" : ""}`}>
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="6" width="20" height="12" rx="2"></rect>
              <path d="M2 10h20"></path>
            </svg>
            <span class="nav-label">Billing</span>
          </a>
          <a href="/app/settings" class={`nav-item ${Astro.url.pathname === "/app/settings" ? "active" : ""}`}>
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="3"></circle>
              <path d="M12 2v3M12 19v3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M2 12h3M19 12h3M4.9 19.1L7 17M17 7l2.1-2.1"></path>
            </svg>
            <span class="nav-label">Settings</span>
          </a>
          <a href="/app/budgets" class={`nav-item ${Astro.url.pathname === "/app/budgets" ? "active" : ""}`}>
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 4h16v16H4z"></path>
              <path d="M7 14l3-3 2 2 5-5"></path>
            </svg>
            <span class="nav-label">Budgets</span>
          </a>
        </nav>

        <div class="side-footer">
          <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle theme">
            <span class="theme-dot"></span>
            <span class="theme-label" id="theme-label">Dark</span>
          </button>
          <UserButton />
        </div>
      </aside>

      <section class="workspace">
        <header class="header">
          <div class="header-label">Telemetry workspace</div>
          <h1>{title}</h1>
          {description && <p>{description}</p>}
        </header>
        <main class="content">
          <slot />
        </main>
      </section>
    </div>

    <script>
      const html = document.documentElement;
      const sidebarKey = "tfg-sidebar-collapsed";
      const themeKey = "tfg-theme";

      const sidebarToggle = document.getElementById("sidebar-toggle");
      const themeToggle = document.getElementById("theme-toggle");
      const themeLabel = document.getElementById("theme-label");

      function applyTheme(theme) {
        html.setAttribute("data-theme", theme);
        localStorage.setItem(themeKey, theme);
        if (themeLabel) {
          themeLabel.textContent = theme === "dark" ? "Dark" : "Light";
        }
      }

      if (sidebarToggle) {
        sidebarToggle.addEventListener("click", () => {
          html.classList.toggle("sidebar-collapsed");
          localStorage.setItem(sidebarKey, String(html.classList.contains("sidebar-collapsed")));
        });
      }

      if (themeToggle) {
        themeToggle.addEventListener("click", () => {
          const current = html.getAttribute("data-theme") === "light" ? "light" : "dark";
          applyTheme(current === "dark" ? "light" : "dark");
        });
      }

      const currentTheme = html.getAttribute("data-theme") === "light" ? "light" : "dark";
      applyTheme(currentTheme);
    </script>
  </body>
</html>
